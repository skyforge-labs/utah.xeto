// Abstract Base Relief Fan with all possible points (optional)

UtahReliefFan: UtahEquip & UtahRelief & UtahFan {

  points: {

    fanEnab:    UtahRFEnab?
    fanCmd:     UtahRFanCmd
    fanCmdSts:  UtahRFanCmdSts?
    fanSpd:     UtahRFanSpd?
    fanSpdSts:  UtahRFanSpdSts?
    fanPower:   UtahRFanPower?
    fanEnergy:  UtahRFanEnergy?

    eaFlow:     UtahRFEaFlow?

    dmprCmd:    UtahRFDamperCmd?
    dmprPos:    UtahRFDamperPos?
    dmprPosSts: UtahRFDamperPosSts?

    tempOnSp:   UtahRFTempOnSp?
    tempOffSp:  UtahRFTempOffSp?

  }
}
