// Return Air Points - Temperature, Humidity, Fan, Damper, Pressure

// Return Air Points

//////////////////////////////////////////////////////////////////////////
// Return air temperature
//////////////////////////////////////////////////////////////////////////

// UtahRaTemp → utah/points.cross.xeto

// Return air temperature setpoint
UtahRaTempSp: UtahReturn & UtahAirTempSp & UtahHisCov{
  navName: "RaTempSp"
  color: Str? "green"
}

//////////////////////////////////////////////////////////////////////////
// Return air humidity
//////////////////////////////////////////////////////////////////////////

UtahRaHum: UtahReturn & UtahAirHumiditySensor & UtahHisSampledMajorEquip {
  navName: "RaHum"
}

// Return air Dehumidify setpoint
UtahRaDehumidifySp: UtahReturn & UtahAirDehumidifySp & UtahHisCov {
  navName: "RaHumSp"
}

// Return air Humidify setpoint
UtahRaHumidifySp: UtahReturn & UtahAirHumidifySp & UtahHisCov {
  navName: "RaHumSp"
}

//////////////////////////////////////////////////////////////////////////
// Return air damper
//////////////////////////////////////////////////////////////////////////

// Return air damper position
UtahRaDmprPos: UtahReturn & UtahDamperPos & UtahHisSampledMajorEquip {
  navName: "RaDmprPos"
}

UtahRaDmprPosSts: UtahReturn & UtahDamperPosSts & UtahHisSampledMajorEquip {
  navName: "RaDmprPosSts"
}

//////////////////////////////////////////////////////////////////////////
// Return air fan command
//////////////////////////////////////////////////////////////////////////

UtahRaFanCmd: UtahReturn & UtahFanCmd & UtahHisCov {
  navName: "RaFanCmd"
}

// Return air fan status
UtahRaFanCmdSts: UtahReturn & UtahFanCmdSts & UtahHisCov {
  navName: "RaFanSts"
}

// Return air fan speed
UtahRaFanSpd: UtahReturn & UtahFanSpd & UtahHisSampledMajorEquip {
  navName: "RaFanSpd"
}

UtahRaFanSpdSts: UtahReturn & UtahFanSpdSts & UtahHisSampledMajorEquip {
  navName: "RaFanSpdSts"
}

// Return air fan frequency
UtahRaFanFreq: UtahReturn & UtahFanFreqSensor & UtahHisSampledMajorEquip {
  navName: "RaFanFreq"
}

// Return air fan enable
UtahRaFanEnab: UtahReturn & UtahFanEnabCmd & UtahHisCov {
  navName: "RaFanEnab"
}

// Return air fan electrical power
UtahRaFanPower: UtahReturn & UtahFanPowerPoint & UtahHisSampledMajorEquip {
  navName: "RaFanPower"
}

// Return air fan alarm
UtahRaFanAlrm: UtahReturn & UtahFanAlarmPoint & UtahHisCov {
  navName: "RaFanAlrm"
}

//////////////////////////////////////////////////////////////////////////
// Return air flow
//////////////////////////////////////////////////////////////////////////

UtahRaFlow: UtahReturn & UtahAirFlowSensor & UtahHisSampledMajorEquip {
  navName: "RaFlow"
}

UtahRaFlowSp: UtahReturn & UtahAirFlowSp & UtahHisCov {
  navName: "RaFlowSp"
}

//////////////////////////////////////////////////////////////////////////
// Return air CO2
//////////////////////////////////////////////////////////////////////////

UtahRaCO2: UtahReturn & UtahAirCo2Sensor & UtahHisSampledMajorEquip {
  navName: "RaCO2"
}

UtahRaCO2Sp: UtahReturn & UtahAirCo2Sp & UtahHisCov {
  navName: "RaCO2Sp"
}

//////////////////////////////////////////////////////////////////////////
// Return air pressure
//////////////////////////////////////////////////////////////////////////

UtahRaPress: UtahReturn & UtahAirPressureSensor & UtahHisSampledMajorEquip {
  navName: "RaPress"
}

// Return air pressure setpoint
UtahRaPressSp: UtahReturn & UtahAirPressureSp & UtahHisCov {
  navName: "RaPressSp"
}

// Return air pressure high alarm
UtahRaPressAlrmHi: UtahReturn & UtahAirPressureAlarmPoint & UtahHisCov {
  high
  navName: "RaPressAlrmHi"
}
