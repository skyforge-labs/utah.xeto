    phCwlTemp: UtahPhCWLTemp?
    phCalTemp: UtahPhCALTemp?

    // Chilled Water Points
    chwCPCmdSts: UtahChWCPCmdSts?
    chwCPCmd: UtahChWCPCmd?
    chwIsoVlvCmd: UtahChWIsoVlvCmd?
    chwVlvPos: UtahChWVlvPos?
    chwVlvPosSts: UtahChWVlvPosSts?
    ccwlTemp: UtahChWCWLTemp?
    ccweTemp: UtahChWCWETemp?
    ccalHum: UtahChWCALHum?
    ccwFlow: UtahChWFlow?
    chcFlow: UtahChWCFlow?
    chcDP: UtahChWCDP?
    chcPower: UtahChWCPower?
    chcEnergy: UtahChWCEnergy?
    clgCmd: UtahClgCmd?

    // Cooling Coil Air Points
    ccfbdCmd: UtahCoolingBypDmprCmd?
    ccfbdCmdSts: UtahCoolingBypDmprCmdSts?
    ccfbdPos: UtahCoolingBypDmprPos?
    ccfbdPosSts: UtahCoolingBypDmprPosSts?
    ccfbdTemp: UtahCoolingBypDaTemp?
    ccBypFanCmd: UtahCoolingBypFanCmd?
    ccalTemp: UtahChWCALTemp?
    ccstageSts: UtahDxClgStageCmdSts?
    ccstageCmd: UtahDxClgStageCmd?
    ccalTempSp: UtahChWCALTempSp?
    dxHtgStageCmd: UtahDxHtgStageCmd?
    dxHtgStageCmdSts: UtahDxHtgStageCmdSts?
    htgStageSts: UtahHtgStageSts?
    dxCalTemp: UtahDxCALTemp?
    dxCompCmd: UtahDxCompCmd?
    dxCompCmdSts: UtahDxCompCmdSts?
    dxCompCurrent: UtahDxCompCurrent?
    dxRevVlvCmd: UtahDxRevVlvCmd?
    dxRevVlvCmdSts: UtahDxRevVlvCmdSts?
    condFanCmd: UtahCondFanCmd?
    condFanCmdSts: UtahCondFanCmdSts?
    condFanCurrent: UtahCondFanCurrent?
    cwETemp: UtahCWETemp?
    cwLTemp: UtahCWLTemp?
    // Economizer Points
    econMode: UtahEconModeEnum?
//    econModeStr: UtahEconModeStr?  // No String data type?

    // Humidifier Points
    humidifierEnab: UtahHumidifierEnab?
