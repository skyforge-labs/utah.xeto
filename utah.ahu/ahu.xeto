}

AhuSingleZone: UtahAhu {
  directZone
  singleDuct

  points: {
    // Single-zone AHUs serve the zone directly, so require the core zone sensor.
    spcTemp: UtahZoneTemp
    spcTempSp: UtahZoneTempSp
    coolEffSp: UtahZoneTempSpEffClg?
    heatEffSp: UtahZoneTempSpEffHtg?

    spcHum: UtahSpcHum?
    spcCO2: UtahSpcCO2?
    spcCO2Sp: UtahSpcCO2Sp?
    spcPress: UtahSpcPress?
    spcPressSp: UtahSpcPressSp?
  }
}
