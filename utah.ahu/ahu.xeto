    hrCmdSts: UtahHrCmdSts?
    hrwetTemp: UtahHRCWETemp?
    hrwltTemp: UtahHRCWLTemp?
    hrCalTemp: UtahHRCALTemp?
    hrVlvPos: UtahHRVlvPos?
    hrVlvPosSts: UtahHRVlvPosSts?
    hrwFlow: UtahHRWFlow?
    hrwVolFlow: UtahHRWVolFlow?
    hrwMassFlow: UtahHRWMassFlow?
    hrwPower: UtahHRWPower?
    hrwEnergy: UtahHRWEnergy?
    hrwCPCmd: UtahHRWCPCmd?
