    hwVlvPosSts: UtahHWVlvPosSts?
    hwcalTemp: UtahHWCALTemp?
    hwcaeTemp: UtahHWCAETemp?
    hwcwlTemp: UtahHWCWLTemp?
    hwcweTemp: UtahHWCWETemp?
    hwcFlow: UtahHWCFlow?
    hwcDP: UtahHWCDP?
