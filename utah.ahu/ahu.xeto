    oaDmprCmdSts: UtahOaDmprCmdSts?
    oaMinDmprPos: UtahOaMinDmprPos?
    oaMinDmprCmd: UtahOaMinDmprCmd?
    oaFlow: UtahOaFlow?
    oaFlowSp: UtahOaFlowSp?
    oaFlowSpMin: UtahOaFlowSpMin?
    oaPress: UtahOaPress?
    oaPressSp: UtahOaPressSp?
    oaFanCmd: UtahOaFanCmd?
    oaFanCmdSts: UtahOaFanCmdSts?
    oaFanEnab: UtahOaFanEnab?
    oaFanSpd: UtahOaFanSpd?
    oaFanSpdSts: UtahOaFanSpdSts?
    oaFanFreq: UtahOaFanFreq?
    oaFanPower: UtahOaFanPower?

    // Mixed Air Points
    maTemp: UtahMaTemp?
    maTempSp: UtahMaTempSp?
    maDmprCmd: UtahMaDmprCmd?
    maDmprPos: UtahMaDmprPos?
    maDmprPosSts: UtahMaDmprPosSts?
    maDmprPosMin: UtahMaDmprPosMin?
    maFlow: UtahMaFlow?
    maHum: UtahMaHum?

    // Hot Water Heating Points
    hwcCmd: UtahHWCPCmd?
    hwcSpeed: UtahHWCPSpeed?

    hwcPts: UtahHWCPSts?
    hwIsoVlvCmd: UtahHWIsoVlvCmd?
    hwIsoVlvPos: UtahHWIsoVlvPos?
