// Abstract Base AHU with all possible points (optional)
// Concrete implementations tighten requirements for specific AHU types

UtahAhu: Ahu {

  hotWaterPlantRef: Ref?
  chilledWaterPlantRef: Ref?
  siteRef: Ref<of: Site>
  points: {

    // Optional mapping points retained from the SkySpark 3 library.
    effectiveOccCmd: UtahEffectiveOccCmd?
    clgOutput: UtahClgOutput?
    daHumSp: UtahDaHumSp?
    eaFanCmd: UtahEaFanCmd?
    eaFanCmdSts: UtahEaFanCmdSts?
    eaFanSpdSts: UtahEaFanSpdSts?
    eaDmprPos: UtahEaDmprPos?
    oaCO2: UtahOaCO2?
    clgDemand: UtahClgDemand?
    humidifierOutputCmd: UtahHumidifierOutputCmd?
    daFanElecPower: UtahDaFanElecPower?
    raFanElecPower: UtahRaFanElecPower?
    ahuState: UtahAhuState?
    hvacModeSts: UtahAhuHvacModeSts?
    econAvailable: UtahEconAvailable?
    chwReturnTemp: UtahChWReturnTemp?
    hwDP: UtahHwDP?
    preheatPumpCmd: UtahPreheatPumpCmd?

    // General Points
    occCmd: UtahOccCmd?
    occMode: UtahOccMode?
    bldgPress: UtahBldgPress?
    bldgPressSp: UtahBldgPressSp?
    frzStat: UtahFrzStat?
    fireAlrmShutdwn: UtahFireAlrmShutdwn?
    killSwitch: UtahKillSwitch?
    wtrAlrm: UtahWtrAlrm?
    isoDmprCmd: UtahIsoDmprCmd?
    isoDmprCmdSts: UtahIsoDmprCmdSts?

    // Filter Points
    filterAlrm: UtahFilterAlrm?
    filterSts: UtahFilterSts?
    filterDP: UtahFilterDP?
    preFilterDP: UtahPreFilterDP?
    finalFilterDP: UtahFinalFilterDP?

    // Space/Zone Points (for single-zone direct AHUs)
    spcCO2: UtahSpcCO2?
    spcCO2Sp: UtahSpcCO2Sp?
    spcHum: UtahSpcHum?
    spcPress: UtahSpcPress?
    spcPressSp: UtahSpcPressSp?
    spcTemp: UtahZoneTemp?
    spcTempSp: UtahZoneTempSp?
    occCoolSp: UtahOccCoolSp?
    occHeatSp: UtahOccHeatSp?
    unoccCoolSp: UtahUnoccCoolSp?
    unoccHeatSp: UtahUnoccHeatSp?

    // Discharge Air Points
    daFanCmd: UtahDaFanCmd?
    daFanCmdSts: UtahDaFanCmdSts?
    daFanEnab: UtahDaFanEnab?
    daFanAlrm: UtahDaFanAlrm?
    daFanSpd: UtahDaFanSpd?
    daFanSpdSts: UtahDaFanSpdSts?
    daFanFreq: UtahDaFanFreq?
    daFanPower: UtahDaFanPower?
    daFlow: UtahDaFlow?
    daFlowSp: UtahDaFlowSp?
    daHum: UtahDaHum?
    daHumLmtHi: UtahDaHumLmtHi?
    daHumLmtLow: UtahDaHumLmtLow?
    daPress: UtahDaPress?
    daPressSp: UtahDaPressSp?
    daPressAlrmHi: UtahDaPressAlarmHi?
    daTemp: UtahDaTemp?
    daTempSp: UtahDaTempSp?
    daTempEffSp: UtahDaTempEffSp?
    daTempHiLmt: UtahDaTempHiLmt?
    daTempSpMin: UtahDaTempSpMin?
    daTempSpMax: UtahDaTempSpMax?

    // Return Air Points
    raTemp: UtahRaTemp?
    raHum: UtahRaHum?
    raHumSp: UtahRaHumidifySp?
    raDehumidifyHsp: UtahRaDehumidifySp?
    raDmprPos: UtahRaDmprPos?
    raDmprPosSts: UtahRaDmprPosSts?
    raFanCmd: UtahRaFanCmd?
    raFanCmdSts: UtahRaFanCmdSts?
    raFanEnab: UtahRaFanEnab?
    raFanAlrm: UtahRaFanAlrm?
    raFanSpd: UtahRaFanSpd?
    raFanSpdSts: UtahRaFanSpdSts?
    raFanFreq: UtahRaFanFreq?
    raFanPower: UtahRaFanPower?
    raFlow: UtahRaFlow?
    raFlowSp: UtahRaFlowSp?
    raCO2: UtahRaCO2?
    raCO2Sp: UtahRaCO2Sp?
    raPress: UtahRaPress?
    raPressSp: UtahRaPressSp?
    raPressAlrmHi: UtahRaPressAlrmHi?
    raTempSp: UtahRaTempSp?

    // Relief/Exhaust Air Points
    rlfFanCmd: UtahRlfFanCmd?
    rlfFanCmdSts: UtahRlfFanCmdSts?
    rlfFanEnab: UtahRlfFanEnab?
    rlfFanSpd: UtahRlfFanSpd?
    rlfFanSpdSts: UtahRlfFanSpdSts?
    rlfFanFreq: UtahRlfFanFreq?
    rlfFanPower: UtahRlfFanPower?
    rlfDmprCmd: UtahRlfDmprCmd?
    rlfDmprCmdSts: UtahRlfDmprCmdSts?
    rlfDmprPos: UtahRlfDmprPos?
    rlfDmprPosSts: UtahRlfDmprPosSts?
