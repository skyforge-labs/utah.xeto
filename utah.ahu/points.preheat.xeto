//
// Preheat Coil Points - Valve, Water/Air Temperatures

//////////////////////////////////////////////////////////////////////////
// Preheat valve
//////////////////////////////////////////////////////////////////////////

// Preheat valve position command (%)
UtahPhVlvPos: UtahPreheatCoil & UtahValvePos & UtahHisSampledMajorEquip {
  hot
  water
  navName: "PhVlvPos"
}

// Preheat valve position feedback
UtahPhVlvPosSts: UtahPreheatCoil & UtahValvePosSts & UtahHisSampledMajorEquip {
  hot
  water
  navName: "PhVlvPosSts"
}

//////////////////////////////////////////////////////////////////////////
// Preheat coil temperatures
//////////////////////////////////////////////////////////////////////////

// Preheat coil water entering temperature
UtahPhCWETemp: UtahPreheatCoil & UtahWaterTempEntering & UtahHisSampledMajorEquip {
  hot
  water
  navName: "PhCWETemp"
}

// Preheat coil water leaving temperature
UtahPhCWLTemp: UtahPreheatCoil & UtahWaterTempLeaving & UtahHisSampledMajorEquip {
  hot
  water
  navName: "PhCWLTemp"
}

// Preheat coil air leaving temperature
UtahPhCALTemp: UtahPreheatCoil & UtahAirTempLeaving & UtahHisSampledMajorEquip {
  hot
  water
  navName: "PhCALTemp"
}
