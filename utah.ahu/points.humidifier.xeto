// Humidifier Points - Enable, Command, Status, Output, Valve, Fan Speed

//////////////////////////////////////////////////////////////////////////
// Humidifier Points
//////////////////////////////////////////////////////////////////////////

// Humidifier enable (permission to run). Not cmd or proven status.
UtahHumidifierEnab: UtahHumid & BoolPoint & EnableCmd & UtahHisCov {
  navName: "HumidifierEnab"
}

// Humidifier run command (desired on/off). Not enable or proven status.
UtahHumidifierCmd: UtahHumid & BoolPoint & RunCmd & UtahHisCov {
  run
  navName: "HumidifierCmd"
}

// Humidifier run feedback (actual on/off). Matches HumidifierCmd.
UtahHumidifierCmdSts: UtahHumid & RunSensor & UtahHisCov {
  navName: "HumidifierCmdSts"
}

// Humidifier output level (e.g. steam %, scaled demand)
UtahHumidifierOutput: UtahHumid & NumberPoint & SensorPoint & UtahHisSampledMajorEquip {
  navName: "HumidifierOutput"
}

// Humidifier steam valve command
UtahHumidifierStmVlvCmd: UtahHumid & UtahStmVlvCmd & UtahHisCov {
  navName: "HumidifierStmVlvCmd"
}

// Humidifier steam valve position
UtahHumidifierStmVlvPos: UtahHumid & UtahStmVlvPos & UtahHisSampledMajorEquip {
  navName: "HumidifierStmVlvPos"
}

// Humidifier fan Cmd
UtahHumidifierFanCmd: UtahHumid & UtahFanCmd & UtahHisCov {
  navName: "HumidifierFanCmd"
}

// Humidifier fan speed
UtahHumidifierFanSpd: UtahHumid & UtahFanSpd & UtahHisSampledMajorEquip {
  navName: "HumidifierFanSpd"
}

// Humidifier setpoint
UtahHumidSp: UtahAirHumidifySp & UtahHisSampledMajorEquip {
  navName: "HumidifySp"
}
