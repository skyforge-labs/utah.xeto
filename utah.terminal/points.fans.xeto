// Zone Fan points — VAV fan-powered stage cmds only.
// UtahZoneFanCmd / FanModeCmd / FanSpd / FanSts live in utah (shared terminals).

UtahFanSpdHighCmd: UtahZone & UtahFanCmd & UtahHisCov {
    high
    navName: "FanSpdHigh"
}

UtahFanSpdMedCmd: UtahZone & UtahFanCmd & UtahHisCov {
    med
    navName: "FanSpdMed"
}

UtahFanSpdLowCmd: UtahZone & UtahFanCmd & UtahHisCov {
    low
    navName: "FanSpdLow"
}
