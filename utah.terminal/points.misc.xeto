UtahHvacLoad: UtahLoadSensor & UtahHisCov {
    hvacLoad
    navName: "HVACLoad"
}

UtahBypassTimePoint: UtahBypass & NumberPoint & SensorPoint <abstract> {
    bypassTime
    val: Number?
}

UtahBypassTime: UtahBypassTimePoint & UtahHisSampledDefault{
    bypassTime
    navName: "BypTime"
}


UtahZoneAirHvacModeSp: ZoneAirHvacModeSp & EnumPoint & UtahHisCov {
    navName: "HvacMode"
    hisCollectInterval: Number? "24hr"
    enum: Str? "Auto,Cool,Heat,Standby,Off"
}
