// Heat pump mode and state points.

UtahHeatPumpModePoint: EnumPoint <abstract> {
  hvacMode
}

UtahHeatPumpCurrentMode: UtahHeatPumpModePoint & SensorPoint & UtahHisCov {
  navName: "CurrentMode"
}

UtahHeatPumpOperatingState: EnumPoint & SensorPoint & UtahHisCov {
  operatingState
  navName: "OperatingState"
}

UtahHeatPumpDefrostMode: UtahHeatPumpDefrost & EnumPoint & SensorPoint & UtahHisCov {
  navName: "DefrostMode"
}
