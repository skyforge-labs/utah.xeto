// Heat pump equipment.  Use existing Utah point specs first; only define
// heat-pump-specific specs where no shared Utah point currently exists.
UtahHeatPumpTerminal: AirTerminalUnit {
  heatPump
  terminalUnit

  points: {
    // Occupancy / setpoints (terminal convention)
    occ: UtahZoneOccupiedSensor?
    occCmd: UtahZoneOccupiedCmd?
    occMode: UtahZoneOccupiedMode?

    enableCmd: UtahHeatPumpEnableCmd?
    modeCmd: UtahHeatPumpModeCmd?

    spcTempSp: UtahZoneTempSpEff?
    coolEffSp: UtahZoneTempSpEffClg?
    heatEffSp: UtahZoneTempSpEffHtg?

    // Zone / air
    spcTemp: UtahZoneTemp
    daTemp: UtahZoneDaTemp?
    raTemp: UtahRaTemp?
    spcHum: UtahZoneAirHumiditySensor?

    // Discharge airflow
    daFlow: UtahZoneDaFlow?
    daFlowSp: UtahZoneDaFlowSp?

    // Discharge fan (terminal convention)
    fanCmd: UtahZoneFanCmd?
    fanSts: UtahZoneFanCmdSts?
    fanModeCmd: UtahZoneFanModeCmd?
    fanSpd: UtahZoneFanSpd?
    fanSpdSts: UtahZoneFanSpdSts?
    fanRuntime: UtahHeatPumpFanRuntime?

    // Compressor / heating / cooling
    compressorCmd: UtahHeatPumpCompressorCmd?
    compressorSts: UtahHeatPumpCompressorSts?
    compressorSpeed: UtahHeatPumpCompressorPct?
    compressorRuntime: UtahHeatPumpCompressorRuntime?
    heatingSts: UtahHeatPumpHeatingSts?
    coolingSts: UtahHeatPumpCoolingSts?
    currentMode: UtahHeatPumpCurrentMode?
    operatingState: UtahHeatPumpOperatingState?

    // Reversing valve: bool open/close + % modulate
    reversingValveCmd: UtahHeatPumpReversingValveCmd?
    reversingValveSts: UtahHeatPumpReversingValveSts?
    reversingValvePos: UtahHeatPumpReversingValvePos?
    reversingValvePosCmd: UtahHeatPumpReversingValvePosCmd?

    // Alarms
    faultAlrm: UtahHeatPumpFaultAlrm?
    lockoutAlrm: UtahHeatPumpLockoutAlrm?

    // Energy
    power: UtahElecPower?
    energy: UtahElecEnergy?
    currentDraw: UtahHeatPumpCurrentDraw?
  }
}

UtahHeatPump: UtahEquip {
  heatPump
}

// -----------------------------------------------------------------------------
// Water-source heat pump terminal unit
// Example: ceiling-mounted zone heat pump connected to condenser water loop
// -----------------------------------------------------------------------------

UtahWaterSourceHeatPump: UtahHeatPump {
  waterSource

  points: {
    // Water loop
    enteringWaterTemp: UtahWaterTempEntering
    leavingWaterTemp: UtahWaterTempLeaving
    waterValveCmd: UtahHeatPumpValveCmd?
    waterValvePos: UtahHeatPumpValvePosCmd?

    // Unit details
    filterAlrm: UtahHeatPumpFilterAlrm?
    filterHours: UtahHeatPumpFilterHours?
    filterHoursSp: UtahHeatPumpFilterHoursSp?

    // Staging (compressorSpeed inherited from UtahHeatPump)
    coolingStage: UtahCoolingStage?
    heatingStage: UtahHeatingStage?
  }
}


// -----------------------------------------------------------------------------
// Air-source packaged heat pump
// Example: packaged rooftop heat pump serving a zone or small area
// -----------------------------------------------------------------------------

UtahAirSourceHeatPump: UtahHeatPump {
  airSource
  packaged

  points: {
    // Outdoor air / ambient
    oaTemp: UtahOaTemp

    // Defrost
    defrostSts: UtahHeatPumpDefrostSts?
    defrostMode: UtahHeatPumpDefrostMode?

    // Supplemental heat
    auxHeatCmd: UtahHeatPumpAuxHeatCmd?
    auxHeatSts: UtahHeatPumpAuxHeatSts?
    emergencyHeatCmd: UtahHeatPumpEmergencyHeatCmd?
    emergencyHeatSts: UtahHeatPumpEmergencyHeatSts?

    // Economizer / outdoor air
    economizerCmd: UtahEconomizerCmd?
    economizerSts: UtahEconomizerSts?
    oaDmprCmd: UtahOaDmprCmd?
    oaDmprPos: UtahOaDmprPos?
  }
}


// -----------------------------------------------------------------------------
// Packaged rooftop heat pump unit
// Example: RTU with DX heat pump, supply fan, outdoor air damper, optional aux heat
// -----------------------------------------------------------------------------

UtahRooftopHeatPump: UtahAirSourceHeatPump {
  rooftop
  rtu

  points: {
    // Supply air / fan — plant-scale RTU (not zone terminal DAT/fan specs)
    saTemp: UtahSaTemp?
    daTemp: UtahDaTemp?
    fanSts: UtahFanCmdSts
    fanSpdSts: UtahFanSpdSts?

    // Duct / airflow
    ductStaticPressure: UtahDaPress?
    ductStaticPressureSp: UtahDaPressSp?

    // Outdoor air / economizer
    oaTemp: UtahOaTemp
    raTemp: UtahRaTemp?
    maTemp: UtahMaTemp?
    oaDmprPos: UtahOaDmprPos?
    economizerSts: UtahEconomizerSts?

    // Heating / cooling stages
    coolingStage: UtahCoolingStage?
    heatingStage: UtahHeatingStage?
    compressor1Sts: UtahHeatPumpCompressorSts?
    compressor2Sts: UtahHeatPumpCompressorSts?
  }
}


// -----------------------------------------------------------------------------
// Split-system air-source heat pump
// Example: outdoor condenser + indoor fan coil / air handler
// -----------------------------------------------------------------------------

UtahSplitSystemHeatPump: UtahAirSourceHeatPump {
  splitSystem

  points: {
    // Indoor unit (terminal convention)
    occ: UtahZoneOccupiedSensor?
    occCmd: UtahZoneOccupiedCmd?
    occMode: UtahZoneOccupiedMode?
    spcTemp: UtahZoneTemp
    spcTempSp: UtahZoneTempSpEff?
    coolEffSp: UtahZoneTempSpEffClg?
    heatEffSp: UtahZoneTempSpEffHtg?
    daTemp: UtahZoneDaTemp?
    spcHum: UtahZoneAirHumiditySensor?
    fanCmd: UtahZoneFanCmd?
    fanModeCmd: UtahZoneFanModeCmd?
    fanSpd: UtahZoneFanSpd?
    fanSts: UtahZoneFanCmdSts?
    fanSpdSts: UtahZoneFanSpdSts?

    // Outdoor unit
    oaTemp: UtahOaTemp
    compressorSts: UtahHeatPumpCompressorSts?
    reversingValveCmd: UtahHeatPumpReversingValveCmd?

    // Supplemental heat
    auxHeatSts: UtahHeatPumpAuxHeatSts?
    emergencyHeatSts: UtahHeatPumpEmergencyHeatSts?
  }
}


// -----------------------------------------------------------------------------
// VRF / VRV heat pump system
// Example: one outdoor unit serving many indoor terminal units
// -----------------------------------------------------------------------------

UtahVrfHeatPumpSystem: UtahHeatPump {
  vrf
  refrigerant

  points: {
    // Outdoor unit / system
    oaTemp: UtahOaTemp
    systemMode: UtahHeatPumpCurrentMode?
    compressorSts: UtahHeatPumpCompressorSts?
    // compressorSpeed inherited from UtahHeatPump
    refrigerantSuctionTemp: UtahHeatPumpSuctionTemp?
    refrigerantDischargeTemp: UtahHeatPumpDischargeTemp?
    suctionPress: UtahHeatPumpSuctionPress?
    dischargePress: UtahHeatPumpDischargePress?

    // System alarms
    faultAlrm: UtahHeatPumpFaultAlrm?
    lockoutAlrm: UtahHeatPumpLockoutAlrm?
  }
}


// -----------------------------------------------------------------------------
// VRF indoor terminal unit
// Example: wall cassette, ceiling cassette, ducted indoor unit
// -----------------------------------------------------------------------------

UtahVrfIndoorUnit: UtahEquip {
  vrf
  terminalUnit
  refrigerant

  points: {
    // Occupancy / setpoints (terminal convention)
    occ: UtahZoneOccupiedSensor?
    occCmd: UtahZoneOccupiedCmd?
    occMode: UtahZoneOccupiedMode?
    enableCmd: UtahHeatPumpEnableCmd?
    modeCmd: UtahHeatPumpModeCmd?
    spcTempSp: UtahZoneTempSpEff?
    coolEffSp: UtahZoneTempSpEffClg?
    heatEffSp: UtahZoneTempSpEffHtg?

    // Zone / air
    spcTemp: UtahZoneTemp
    daTemp: UtahZoneDaTemp?
    raTemp: UtahRaTemp?
    daFlow: UtahZoneDaFlow?
    daFlowSp: UtahZoneDaFlowSp?
    spcHum: UtahZoneAirHumiditySensor?

    // Discharge fan / vane (terminal convention)
    fanCmd: UtahZoneFanCmd?
    fanModeCmd: UtahZoneFanModeCmd?
    fanSpd: UtahZoneFanSpd?
    fanSts: UtahZoneFanCmdSts?
    fanSpdSts: UtahZoneFanSpdSts?
    vanePos: UtahVanePos?

    // Refrigerant valve / status
    expansionValvePos: UtahExpansionValvePos?
    heatingSts: UtahHeatPumpHeatingSts?
    coolingSts: UtahHeatPumpCoolingSts?
    currentMode: UtahHeatPumpCurrentMode?

    // Alarms
    faultAlrm: UtahHeatPumpFaultAlrm?
  }
}


// -----------------------------------------------------------------------------
// Ground-source heat pump
// Example: heat pump connected to geothermal condenser water loop
// -----------------------------------------------------------------------------

UtahGroundSourceHeatPump: UtahWaterSourceHeatPump {
  groundSource
  geothermal

  points: {
    // Ground loop
    enteringWaterTemp: UtahWaterTempEntering
    leavingWaterTemp: UtahWaterTempLeaving
    groundLoopFlow: UtahWaterFlowSensor?
    groundLoopPumpSts: UtahPumpCmdSts?

    // Performance
    cop: UtahHeatPumpCop?
  }
}


// -----------------------------------------------------------------------------
// Heat pump chiller / central plant heat pump
// Example: central air-to-water or water-to-water machine producing HHW/CHW
// -----------------------------------------------------------------------------

UtahHeatPumpChiller: UtahEquip {
  heatPump
  chiller
  plant

  points: {
    // Commands / mode
    enableCmd: UtahHeatPumpEnableCmd?
    modeCmd: UtahHeatPumpModeCmd?
    currentMode: UtahHeatPumpCurrentMode?
    operatingState: UtahHeatPumpOperatingState?

    // Chilled water side
    chwSupplyTemp: UtahChwSupplyTemp
    chwReturnTemp: UtahChwReturnTemp
    chwSupplyTempSp: UtahChwSupplyTempSp?
    chwFlow: UtahChWFlow?
    chwPumpSts: UtahPumpCmdSts?

    // Heating hot water side
    hhwSupplyTemp: UtahHhwSupplyTemp
    hhwReturnTemp: UtahHhwReturnTemp
    hhwSupplyTempSp: UtahHhwSupplyTempSp?
    hhwFlow: UtahHhwFlow?
    hhwPumpSts: UtahPumpCmdSts?

    // Source side
    sourceEnteringTemp: UtahWaterTempEntering?
    sourceLeavingTemp: UtahWaterTempLeaving?
    oaTemp: UtahOaTemp?

    // Compressor / capacity
    compressorSts: UtahHeatPumpCompressorSts?
    compressorSpeed: UtahHeatPumpCompressorPct?
    capacityCmd: UtahCapacityCmd?
    capacity: UtahCapacity?

    // Energy / performance
    power: UtahElecPower?
    energy: UtahElecEnergy?
    currentDraw: UtahHeatPumpCurrentDraw?
    cop: UtahHeatPumpCop?

    // Alarms
    faultAlrm: UtahHeatPumpFaultAlrm?
    lockoutAlrm: UtahHeatPumpLockoutAlrm?
  }
}


// -----------------------------------------------------------------------------
// Exhaust-air heat pump
// Example: DOAS / ventilation unit recovering heat from exhaust air
// -----------------------------------------------------------------------------

UtahExhaustAirHeatPump: UtahHeatPump {
  exhaustAir
  ventilation

  points: {
    // Air streams
    oaTemp: UtahOaTemp
    eaTemp: UtahEaTemp?
    saTemp: UtahSaTemp?
    raTemp: UtahRaTemp?

    // Fans
    supplyFanSts: UtahFanCmdSts?
    exhaustFanSts: UtahFanCmdSts?
    supplyFanSpeed: UtahFanSpd?
    exhaustFanSpeed: UtahFanSpd?

    // Heat pump
    compressorSts: UtahHeatPumpCompressorSts?
    heatingSts: UtahHeatPumpHeatingSts?
    coolingSts: UtahHeatPumpCoolingSts?
    defrostSts: UtahHeatPumpDefrostSts?

    // Ventilation control
    oaDmprPos: UtahOaDmprPos?
    co2: UtahAirCo2Sensor?
  }
}
