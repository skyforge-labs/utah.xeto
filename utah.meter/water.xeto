// Generic water meters: hydronic thermal (BTU) meters and potable/utility flow meters.

// Hydronic thermal energy meter (measures flow + delta-T on a water loop).
// Note: "btu" from source data is not a defined ph marker; modeled as thermal FlowMeter.
UtahBtuMeter: UtahMeter & FlowMeter <abstract> {
  thermal
  water
  points: {
    // Energy is the core meter total; the rest are common but optional.
    energy: UtahMeterThermalEnergy
    power: UtahMeterThermalPower?
    flow: UtahMeterWaterFlow?
    enteringTemp: UtahMeterEnteringWaterTemp?
    leavingTemp: UtahMeterLeavingWaterTemp?
  }
}

// Chilled water BTU meter (e.g. CHWS BTU).
UtahChwBtuMeter: UtahBtuMeter {
  chilled
}

// Hot water BTU meter (e.g. HWS BTU).
UtahHwBtuMeter: UtahBtuMeter {
  hot
}

// Condenser water BTU meter (e.g. CWS-BTU).
UtahCwBtuMeter: UtahBtuMeter {
  condenser
}

// Potable/irrigation water utility flow meter.
UtahWaterMeter: UtahUtilityMeter & WaterMeter {
  points: {
    volume: UtahMeterWaterVolume
    flow: UtahMeterWaterFlow?
  }
}
