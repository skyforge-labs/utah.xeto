// Chiller Oil Points -  Oil Temperatures

//////////////////////////////////////////////////////////////////////////
// Chiller Oil Temperatures
//////////////////////////////////////////////////////////////////////////

UtahChlrOilTemp: UtahChlrOil & NumberPoint & SensorPoint & UtahHisSampledMajorEquip {
  temp
  unit: Unit <quantity:"temperature"> "°F"
  navName: "ChlrOilTemp"
}

// ph 5.0: HeatCmd → HeatRunCmd
UtahChlrOilHeatCmd: UtahChlrOil & HeatRunCmd & UtahHisCov {
  navName: "ChlrOilHeatCmd"
}

// ph 5.0: HeatCmd status → HeatRunSensor
UtahChlrOilHeatCmdSts: UtahChlrOil & HeatRunSensor & UtahHisCov {
  navName: "ChlrOilHeatCmdSts"
}
