// Fan Points

//////////////////////////////////////////////////////////////////////////
//  Cooling Tower Fans
//////////////////////////////////////////////////////////////////////////

// Cooling Tower Enabled
UtahCTFanEnab: UtahClgTower & UtahFanEnabCmd & UtahHisCov {
  navName: "CTFanEnab"
}

// Cooling Tower fan command
UtahCTFanCmd: UtahClgTower & UtahFanCmd & UtahHisCov {
  navName: "CTFanCmd"
}

// Cooling Tower fan command status
UtahCTFanCmdSts: UtahClgTower & UtahFanCmdSts & UtahHisCov {
  navName: "CTFanCmdSts"
}

// Cooling Tower fan speed
UtahCTFanSpd: UtahClgTower & UtahFanSpd & UtahHisCov {
  navName: "CTFanSpd"
}

// Cooling Tower fan speed status
UtahCTFanSpdSts: UtahClgTower & UtahFanSpdSts & UtahHisCov {
  navName: "CTFanSpdSts"
}

//////////////////////////////////////////////
// Fan Freq
//////////////////////////////////////////////

// Fan Frequency. Typically from VRF
UtahCTFanFreq: UtahClgTower & UtahFanFreqSensor & UtahHisSampledMajorEquip <abstract>{
    }

//////////////////////////////////////////////
// Fan Power  Typically from VRF
//////////////////////////////////////////////

// Fan Power
UtahCTFanPower: UtahClgTower & UtahFanPowerPoint & UtahHisSampledMajorEquip <abstract>{
    }

//////////////////////////////////////////////
// Fan Energy  Typically from VRF
//////////////////////////////////////////////

// Fan Energy
UtahCTFanEnergy: UtahClgTower & UtahFanEnergyPoint & UtahHisSampledMajorEquip <abstract>{
    }
