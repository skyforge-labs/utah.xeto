// Hot-water plant tank points (domain-specific)

UtahHWTankTemp: UtahTank & UtahWaterTempSensor & UtahHisSampledMajorEquip {
  hot
  water
  navName: "HWTankTemp"
}

UtahHWTankTempSp: UtahTank & UtahWaterTempSp & UtahHisSampledMajorEquip {
