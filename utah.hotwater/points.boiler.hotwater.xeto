// Hot Water System Points - Valves, Temperatures, Circ Pumps, Flow

//////////////////////////////////////////////////////////////////////////
// Isolation Valve Points
//////////////////////////////////////////////////////////////////////////

// Hot water isolation valve position status
UtahHWIsoVlvPosSts: UtahIsoValvePosSts & UtahHisCov {
  hot
  water
  isolation
  navName: "HWIsoVlvPosSts"
}

//////////////////////////////////////////////////////////////////////////
// Hot Water Temperature Points
//////////////////////////////////////////////////////////////////////////

// Hot water entering temperature
UtahHWETemp: UtahWaterTempEntering & UtahHisSampledMajorEquip {
  hot
  water
  navName: "HWETemp"
}

// Hot water leaving temperature
UtahHWLTemp: UtahWaterTempLeaving & UtahHisSampledMajorEquip {
  hot
  water
  navName: "HWLTemp"
}

// Hot water leaving temperature setpoint
UtahHWLTempSp: UtahWaterTempLeavingSp & UtahHisCov {
  hot
  water
  navName: "HWLTempSp"
}

//////////////////////////////////////////////////////////////////////////
// Pump Command Points
//////////////////////////////////////////////////////////////////////////

// Hot water circulation pump command status
UtahHWCPCmdSts: UtahCPCmdSts & UtahHisCov {
  hot
  water
  navName: "HWCPCmdSts"
}

//////////////////////////////////////////////////////////////////////////
// Hot Water Flow Points
//////////////////////////////////////////////////////////////////////////

// Hot water flow
UtahHWFlow: UtahWaterFlowSensor & UtahHisSampledMajorEquip {
  hot
  water
  navName: "HWFlow"
}

//////////////////////////////////////////////////////////////////////////
// Hot Water Volume Points
//////////////////////////////////////////////////////////////////////////

// Hot water volume
UtahHWVolume: UtahWaterVolumeSensor & UtahHisSampledMajorEquip {
  hot
  water
  navName: "HWVolume"
}

//////////////////////////////////////////////////////////////////////////
// Hot Water Diff Pressure Points
//////////////////////////////////////////////////////////////////////////

// Hot Water Diff Pressure
UtahHWDP: UtahWaterDPSensor & UtahHisSampledMajorEquip {
  hot
  water
  navName: "HWDP"
  unit: "psi"
}

// Hot Water Diff Pressure Setpoint
UtahHWDPSp: UtahWaterDPSp & UtahHisSampledMajorEquip {
  hot
  water
  navName: "HWDP"
  unit: "psi"
}
