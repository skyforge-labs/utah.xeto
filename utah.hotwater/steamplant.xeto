// Steam plant under HWS lib (SP tags: hvac, plant, steam).

UtahSteamPlant: SteamPlant {
  hvac
  hotWaterPlantRef: Ref?

  points: {
    stmLTemp:   UtahStmLTemp?
    stmLTempSp: UtahStmLTempSp?
    stmLPress:  UtahStmLPress?
    stmLFlow:   UtahStmLFlow?
    stmPower:   UtahStmPower?

    condensateETemp: UtahCondensateETemp?
    condensateFlow:  UtahCondensateFlow?

    flueTemp: UtahFlueTemp?

    mkupWFlow: UtahStmMkupWFlow?
    mkupWVol:  UtahStmMkupWVol?
  }
}
