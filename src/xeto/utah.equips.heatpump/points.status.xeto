// Heat pump status points that do not have shared Utah point specs yet.

UtahHeatPumpCompressorSts: UtahHeatPumpCompressor & RunSensor & UtahHisCov {
  navName: "CompressorSts"
}

UtahHeatPumpReversingValveSts: UtahHeatPumpReversingValve & UtahValveCmdSts & UtahHisCov {
  navName: "ReversingValveSts"
}

UtahHeatPumpHeatingSts: BoolPoint & SensorPoint & UtahHisCov {
  heating
  run
  navName: "HeatingSts"
}

UtahHeatPumpCoolingSts: BoolPoint & SensorPoint & UtahHisCov {
  cooling
  run
  navName: "CoolingSts"
}

UtahHeatPumpDefrostSts: UtahHeatPumpDefrost & BoolPoint & SensorPoint & UtahHisCov {
  navName: "DefrostSts"
}

UtahHeatPumpAuxHeatSts: UtahHeatPumpAuxHeat & RunSensor & UtahHisCov {
  navName: "AuxHeatSts"
}

UtahHeatPumpEmergencyHeatSts: UtahHeatPumpEmergencyHeat & RunSensor & UtahHisCov {
  navName: "EmergencyHeatSts"
}

UtahEconomizerSts: UtahEconomizer & RunSensor & UtahHisCov {
  navName: "EconomizerSts"
}

UtahCoolingStage: UtahDxClgStageCmdSts {
  navName: "CoolingStage"
}

UtahHeatingStage: UtahStageCmdSts & UtahHisCov {
  heating
  navName: "HeatingStage"
}

UtahHeatPumpFaultAlrm: AlarmSensor & UtahHisCov {
  fault
  navName: "FaultAlrm"
}

UtahHeatPumpLockoutAlrm: AlarmSensor & UtahHisCov {
  lockout
  navName: "LockoutAlrm"
}

UtahHeatPumpFilterAlrm: UtahAirFilter & AlarmSensor & UtahHisCov {
  navName: "FilterAlrm"
}
