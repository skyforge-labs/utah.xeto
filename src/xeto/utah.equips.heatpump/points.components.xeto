// Heat-pump-only components used to scope commands, status, and performance points.

UtahHeatPumpCompressor: UtahEquipComponent <abstract> {
  compressor
}

UtahHeatPumpDefrost: UtahEquipComponent <abstract> {
  defrost
}

UtahHeatPumpRefrigerant: UtahEquipComponent <abstract> {
  refrigerant
}

UtahHeatPumpReversingValve: UtahEquipComponent <abstract> {
  reversingValve
}

UtahHeatPumpAuxHeat: UtahEquipComponent <abstract> {
  aux
  heat
}

UtahHeatPumpEmergencyHeat: UtahEquipComponent <abstract> {
  emergency
  heat
}

UtahHeatPumpVane: UtahEquipComponent <abstract> {
  vane
}

UtahHeatPumpExpansionValve: UtahEquipComponent <abstract> {
  expansion
}
