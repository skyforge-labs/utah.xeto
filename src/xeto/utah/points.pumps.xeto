//  Utah Pumps
//////////////////////////////////////////
// Pump Command - Bool
//////////////////////////////////////////

// Pump Enab
UtahPumpEnab: UtahPump & BoolPoint & RunCmd <abstract>{
    enable
    }
  
// Pump Cmd
UtahPumpCmdPoint: UtahPump & BoolPoint <abstract>{
    }
   
// Pump Cmd
UtahPumpCmd: UtahPump & UtahPumpCmdPoint & RunCmd <abstract>{
    }
    
// Pump Cmd status
UtahPumpCmdSts: UtahPump & UtahPumpCmdPoint & RunSensor <abstract>{
    }
  
//////////////////////////////////////////
//  Pump Speed Number
//////////////////////////////////////////

// Generic Pump speed 0-100%
UtahPumpSpdPoint: UtahPump & NumberPoint <abstract>{
    speed
    unit: Unit <fixed> "%"
    }
    
// 0-100% pump speed
UtahPumpSpd: UtahPumpSpdPoint & CmdPoint <abstract>{
    
    }
    
// 0-100% pump speed feedback status sensor 
UtahPumpSpdSts: UtahPumpSpdPoint & SensorPoint <abstract>{
    run
    }

//////////////////////////////////////////
//  Pump Frequency
//////////////////////////////////////////

// Pump Frequency. Typically from VRF
UtahPumpFreq: UtahPump & Freq <abstract>{
    }
    
// Pump Frequency Point
UtahPumpFreqPoint: UtahPumpFreq & NumberPoint <abstract>{
    unit: Unit <quantity:"frequency"> "Hz"
    }

// Pump Frequency Sensor
UtahPumpFreqSensor: UtahPumpFreqPoint & SensorPoint <abstract>{
    }
    
//////////////////////////////////////////
//  Pump Power
//////////////////////////////////////////

// Pump Power. Typically from VRF
UtahPumpPowerPoint: UtahPump & Power & NumberPoint & SensorPoint <abstract>{
    unit: Unit <quantity:"power"> "kW"
    }

//////////////////////////////////////////
//  Pump Energy
//////////////////////////////////////////

// Pump Energy. Typically from VRF
UtahPumpEnergyPoint: UtahPump & Energy & NumberPoint & SensorPoint <abstract>{
    unit: Unit <quantity:"energy"> "kWh"
    }

//////////////////////////////////////////
// Circulation Pump
//////////////////////////////////////////

// Local Circulation Pump vs. Larger System Pump
UtahCircPump: UtahPump <abstract>{
    circ
    }

// Local Circulation Pump Enab
UtahCPEnab: UtahCircPump & BoolPoint & RunCmd <abstract>{
    enable
    }
  
// Local Circulation Pump Cmd
UtahCPCmd: UtahCircPump & RunCmd <abstract>{
    }
    
// Local Circulation Pump Cmd status
UtahCPCmdSts: UtahCircPump & RunSensor <abstract>{
    }

// Local Circulation Pump Speed
UtahCPSpd: UtahCircPump & UtahPumpSpd <abstract>{
    }
    
// Local Circulation Pump Speed status
UtahCPSpdSts: UtahCircPump & UtahPumpSpdSts <abstract>{
    }
  