// Utah Abstract points

// Base Utah point contract for specs that need current-value metadata.
UtahPoint: Point <abstract> {
}

////////////////////////////////////////////////
// Hours
////////////////////////////////////////////////

UtahHoursPoint: UtahHours & NumberPoint <abstract> {
//    doc: "Runtime Hours"
    }

UtahHoursSensor: UtahHours & UtahHoursPoint & SensorPoint <abstract> {
//    doc: "Runtime Hours Sensor"
    }   
    
////////////////////////////////////////////////
// Load
////////////////////////////////////////////////

UtahLoadPoint: UtahLoad & NumberPoint <abstract> {
//    doc: "Equipment load"
    }
    
    
UtahLoadSensor: UtahLoadPoint & SensorPoint <abstract> {
//    doc: "Equipment load sensor"
    }

////////////////////////////////////////////////
// Tons (capacity / plant tonnage sensors)
////////////////////////////////////////////////

UtahTonsPoint: UtahTons & NumberPoint <abstract> {
//    doc: "Tonnage point"
    }

UtahTonsSensor: UtahTonsPoint & SensorPoint <abstract> {
//    doc: "Tonnage sensor"
    }