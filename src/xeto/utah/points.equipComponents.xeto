// Abstract equipment components that are unaffiliated with equip or point

UtahEquipComponent: Entity {

}

UtahAirFilter: UtahEquipComponent & Air <abstract> {
  filter
}

UtahBlr: UtahEquipComponent <abstract> {
  boiler
}

UtahBuilding: UtahEquipComponent <abstract> {
  building
}

UtahBypass: UtahEquipComponent <abstract> { 
  bypass
}

UtahChlr: UtahEquipComponent <abstract> {
  chiller
}

UtahChlrOil: Liquid & UtahChlr <abstract> {
  oil
}

UtahCoil: UtahEquipComponent <abstract> {
  coil
}

UtahClgTower: UtahEquipComponent <abstract> {
  coolingTower
}

UtahCondenser: UtahEquipComponent <abstract> {
  condenser
}

// Shared compressor / reversing valve (AHU DX, HP, etc.)
UtahCompressor: UtahEquipComponent <abstract> {
  compressor
}

UtahReversingValve: UtahEquipComponent <abstract> {
  reversingValve
}

UtahCW: Water & UtahCondenser {
  navName: "CW"
}

UtahColdDeck: UtahEquipComponent <abstract> {
  coldDeck
}

UtahHotDeck: UtahEquipComponent <abstract> {
  hotDeck
}

UtahDualDeck: UtahEquipComponent <abstract> {
  dualDeck
}

UtahCrac: UtahEquipComponent <abstract> {
  crac
}

UtahDamper: UtahEquipComponent <abstract> {
  damper
}

UtahDischarge: UtahEquipComponent <abstract> {
  discharge
}

UtahEconomizer: UtahEquipComponent <abstract> {
  economizer
}

UtahExhaust: UtahEquipComponent <abstract> {
  exhaust
}

UtahHx: UtahEquipComponent <abstract> {
  heatExchanger
}

UtahHxChW: UtahHx & ChilledWater <abstract> {
}

UtahHxSteam: UtahHx & Steam <abstract> {
}

UtahHeatRecovery: UtahEquipComponent <abstract> {
  heatRecovery
}

UtahHours: UtahEquipComponent <abstract> {
  hours
}

UtahHumid: UtahEquipComponent <abstract> {
  humidifier
}

UtahHumidify: UtahEquipComponent <abstract> {
  humidify
}

UtahDehumidify: UtahEquipComponent <abstract> {
  dehumidify
}

UtahFan: UtahEquipComponent & Air <abstract> {
  fan
}

UtahIsolation: UtahEquipComponent <abstract> {
  isolation
}

UtahLoad: UtahEquipComponent <abstract> {
  load
}

UtahMakeup: UtahEquipComponent <abstract> {
  makeup
}

UtahMixed: UtahEquipComponent <abstract> {
  mixed
}

UtahOccupied: UtahEquipComponent <abstract> {
  occ
  occupied
}

UtahPrimary: UtahEquipComponent <abstract> {
  primaryLoop
}

UtahSecondary: UtahEquipComponent <abstract> {
  secondaryLoop
}

UtahReheat: UtahEquipComponent <abstract> {
  reheat
}

UtahUnoccupied: UtahEquipComponent <abstract> {
  unocc
  unoccupied
}

UtahOutside: UtahEquipComponent <abstract> {
  outside
}

UtahPump: UtahEquipComponent <abstract> {
  pump
}

UtahRelief: UtahEquipComponent <abstract> {
  relief
}

UtahSupply: UtahEquipComponent <abstract> {
  supply
}

UtahTransfer: UtahEquipComponent <abstract> {
  transfer
}

UtahReturn: UtahEquipComponent <abstract> {
  return
}

UtahStandby: UtahEquipComponent <abstract> {
  standby
}

UtahSump: UtahEquipComponent <abstract> {
  sump
}

UtahTank: UtahEquipComponent <abstract> {
  tank
}

UtahTons: UtahEquipComponent <abstract> {
  tons
}

UtahValve: UtahEquipComponent <abstract> {
  valve
}

UtahZone: UtahEquipComponent <abstract> {
  zone
}

// Steam plant / HX helpers
UtahFlue: UtahEquipComponent <abstract> {
  flue
}

UtahCondensate: UtahEquipComponent <abstract> {
  condensate
}

