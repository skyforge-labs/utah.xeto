//////////////////////////////////////////////////////////////////////////
// General CHWS Points
//////////////////////////////////////////////////////////////////////////

// Makeup Water Valve
UtahChWMkupWVlvCmd: ChilledWater & UtahMakeupValveCmd & UtahHisSampledMajorEquip {
  navName: "ChWMkupWVlvCmd"
}

// Building Max Chilled Water Valve Position
UtahBldgChWVlvPosMax: ChilledWater & UtahValvePos & UtahHisCov {
  building
  max
  navName: "BldgChWVlvPosMax"
}

// Secondary-loop bypass valve command
UtahChWBypVlvCmd: ChilledWater & UtahBypassValveCmd & UtahHisCov {
  navName: "ChWBypVlvCmd"
}

// Secondary-loop bypass valve position
UtahChWBypVlvPos: ChilledWater & UtahBypassValvePos & UtahHisSampledMajorEquip {
  navName: "ChWBypVlvPos"
}
