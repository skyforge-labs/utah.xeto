// Abstract Base Supply Fan with all possible points (optional)

UtahSupplyFan: UtahEquip & UtahSupply & UtahFan {

  points: {

    fanEnab:    UtahSFEnab?
    fanCmd:     UtahSFanCmd
    fanCmdSts:  UtahSFanCmdSts?
    fanSpd:     UtahSFanSpd?
    fanSpdSts:  UtahSFanSpdSts?
    fanPower:   UtahSFanPower?
    fanEnergy:  UtahSFanEnergy?

    eaFlow:     UtahSFEaFlow?

    dmprCmd:    UtahSFDamperCmd?
    dmprPos:    UtahSFDamperPos?
    dmprPosSts: UtahSFDamperPosSts?

    tempOnSp:   UtahSFTempOnSp?
    tempOffSp:  UtahSFTempOffSp?

  }
}
