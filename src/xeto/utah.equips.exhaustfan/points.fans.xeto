    navName: "EFCmdSts"
}


UtahEFanSpd: UtahExhaust & UtahFanSpd & UtahHisSampledDefault {
    navName: "EFSpd"
}

UtahEFanSpdSts: UtahExhaust & UtahFanSpdSts & UtahHisSampledDefault {
    navName: "EFSpdSts"
}

//  Fan Power
UtahEFanPower: UtahExhaust & UtahFanPowerPoint & UtahHisSampledDefault {
    navName: "EFFanPower"
}

//  Fan Energy
UtahEFanEnergy: UtahExhaust & UtahFanEnergyPoint & UtahHisSampledDefault {
    navName: "EFFanEnergy"
}

