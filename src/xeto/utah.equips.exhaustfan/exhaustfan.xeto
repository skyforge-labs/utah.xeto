// Abstract Base Exhaust with all possible points (optional)

UtahExhaustFan: UtahEquip & UtahExhaust & UtahFan {
  
  points: {

  //  Exhaust Air Points
    fanEnab:    UtahEFEnab?
    fanCmd:     UtahEFanCmd
    fanCmdSts:  UtahEFanCmdSts?
    fanSpd:     UtahEFanSpd?
    fanSpdSts:  UtahEFanSpdSts?
    fanPower:   UtahEFanPower?
    fanEnergy:  UtahEFanEnergy?

    eaFlow:     UtahEFEaFlow?

  //  Exhaust Damper Points
    dmprCmd:    UtahEFDamperCmd?
    dmprPos:    UtahEFDamperPos?
    dmprPosSts: UtahEFDamperPosSts?

  // Temp On/Off Setpoints 
  tempOnSp: UtahTempOnSp?
  tempOffSp: UtahTempOffSp?

    }
}