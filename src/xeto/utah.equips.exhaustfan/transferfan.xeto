// Abstract Base Transfer Fan with all possible points (optional)

UtahTransferFan: UtahEquip & UtahTransfer & UtahFan {

  points: {

    fanEnab:    UtahTFEnab?
    fanCmd:     UtahTFanCmd
    fanCmdSts:  UtahTFanCmdSts?
    fanSpd:     UtahTFanSpd?
    fanSpdSts:  UtahTFanSpdSts?
    fanPower:   UtahTFanPower?
    fanEnergy:  UtahTFanEnergy?

    eaFlow:     UtahTFEaFlow?

    dmprCmd:    UtahTFDamperCmd?
    dmprPos:    UtahTFDamperPos?
    dmprPosSts: UtahTFDamperPosSts?

    tempOnSp:   UtahTFTempOnSp?
    tempOffSp:  UtahTFTempOffSp?

  }
}
