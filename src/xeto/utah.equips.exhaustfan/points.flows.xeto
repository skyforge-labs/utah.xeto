// Exhaust Air Flow

//////////////////////////////////////////////////////////////////////////
// Exhaust Air Flow
//////////////////////////////////////////////////////////////////////////

// Exhaust Air Flow
UtahEFEaFlow: UtahExhaust & UtahAirFlowSensor & UtahHisSampledDefault {
  navName: "EFEaFlow"
}

// Relief Air Flow
UtahRFEaFlow: UtahRelief & UtahAirFlowSensor & UtahHisSampledDefault {
  navName: "RFEaFlow"
}

// Supply Air Flow
UtahSFEaFlow: UtahSupply & UtahAirFlowSensor & UtahHisSampledDefault {
  navName: "SFEaFlow"
}

// Transfer Air Flow
UtahTFEaFlow: UtahTransfer & UtahAirFlowSensor & UtahHisSampledDefault {
  navName: "TFEaFlow"
}