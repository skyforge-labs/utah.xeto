// Steam plant points (SP) for UtahSteamPlant.

// Steam leaving temp
UtahStmLTemp: UtahSteamTempLeaving & UtahHisSampledMajorEquip {
  navName: "StmLTemp"
}

// Steam leaving temp setpoint
UtahStmLTempSp: UtahSteamTempSp & UtahHisCov {
  leaving
  navName: "StmLTempSp"
}

// Steam leaving pressure
UtahStmLPress: UtahSteamPressureLeaving & UtahHisSampledMajorEquip {
  navName: "StmLPress"
}

// Steam leaving flow
UtahStmLFlow: UtahSteamFlowLeaving & UtahHisSampledMajorEquip {
  navName: "StmLFlow"
}

// Steam power / load
UtahStmPower: UtahSteamPowerSensor & UtahHisSampledMajorEquip {
  navName: "StmPower"
}

// Condensate entering temp
UtahCondensateETemp: UtahCondensate & Temp & NumberPoint & SensorPoint & UtahHisSampledMajorEquip {
  entering
  unit: Unit <quantity:"temperature"> "°F"
  navName: "CondensateETemp"
}

// Condensate flow
UtahCondensateFlow: UtahCondensate & Flow & NumberPoint & SensorPoint & UtahHisSampledMajorEquip {
  unit: Unit <quantity:"volumetricFlow"> "gal/min"
  navName: "CondensateFlow"
}

// Flue / stack temp
UtahFlueTemp: UtahFlue & Temp & NumberPoint & SensorPoint & UtahHisSampledMajorEquip {
  unit: Unit <quantity:"temperature"> "°F"
  navName: "FlueTemp"
}

// Makeup water flow
UtahStmMkupWFlow: MakeupWater & UtahWaterFlowSensor & UtahHisSampledMajorEquip {
  navName: "StmMkupWFlow"
}

// Makeup water volume
UtahStmMkupWVol: MakeupWater & UtahWaterVolumeSensor & UtahHisConsumptionMajorEquip {
  navName: "StmMkupWVol"
}
