// General Hot Water Points - Enable, Command

//////////////////////////////////////////////////////////////////////////
// General HWS Points
//////////////////////////////////////////////////////////////////////////

// Makeup Water Valve
UtahHWMkupWVlvCmd: HotWater & UtahMakeupValveCmd & UtahHisSampledMajorEquip {
  navName: "HWMkupWVlvCmd"
}

// Bypass Water Valve command
UtahHWBypVlvCmd: HotWater & UtahBypassValveCmd & UtahHisCov {
  navName: "HWBypVlvCmd"
}

// Bypass Water Valve
UtahHWBypVlvPos: HotWater & UtahBypassValvePos & UtahHisSampledMajorEquip {
  navName: "HWBypVlvPos"
}

// Bypass Water Valve status
UtahHWBypVlvPosSts: HotWater & UtahBypassValvePosSts & UtahHisSampledMajorEquip {
  navName: "HWBypVlvPosSts"
}

// Hot water isolation valve command status (secondary loop SEC)
UtahHWIsoVlvCmdSts: HotWater & UtahIsoValveCmdSts & UtahHisCov {
  navName: "HWIsoVlvCmdSts"
}

// Secondary hot water entering temp setpoint
UtahSecHWETempSp: HotWater & UtahSecondary & UtahWaterTempSp & UtahHisCov {
  entering
  navName: "SecHWETempSp"
}
// Building Max Hot Water Valve Position
UtahBldgHWVlvPosMax: HotWater & UtahValvePos & UtahHisCov {
  building
  max
  navName: "BldgChWVlvPosMax"
}
