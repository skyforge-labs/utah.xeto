// General HWS Steam Heat Exchanger Points - Enable, Command, Temperatures

//////////////////////////////////////////////////////////////////////////
// General Steam Heat Exchanger Points
//////////////////////////////////////////////////////////////////////////

// Heat Exchanger Enabled
UtahHxStmEnab: UtahHxSteam & EnableCmd & UtahHisCov {
  navName: "HxStmEnab"
}

// Heat Exchanger Cmd
UtahHxStmCmd: UtahHxSteam & RunCmd & UtahHisCov {
  navName: "HxStmCmd"
}

// Heat Exchanger Runtime hours
UtahHxStmHours: UtahHxSteam & UtahHoursSensor & UtahHisSampledMajorEquip {
  navName: "HxStmHours"
}


//////////////////////////////////////////////////////////////////////////
// Steam Temperature Points
//////////////////////////////////////////////////////////////////////////

// Steam entering temperature
UtahHxStmETemp: UtahHxSteam & UtahSteamTempEntering & UtahHisSampledMajorEquip {
  navName: "HxStmETemp"
}

// Steam leaving temperature
UtahHxStmLTemp: UtahHxSteam & UtahSteamTempLeaving & UtahHisSampledMajorEquip {
  navName: "HxStmLTemp"
}

//////////////////////////////////////////////////////////////////////////
// Hot Water Temperature Points
//////////////////////////////////////////////////////////////////////////

// Hot water entering temperature
UtahHxStmHWETemp: UtahHxSteam & HotWater & UtahWaterTempEntering & UtahHisSampledMajorEquip {
  navName: "HxStmHWETemp"
}

// Hot water leaving temperature
UtahHxStmHWLTemp: UtahHxSteam & HotWater & UtahWaterTempLeaving & UtahHisSampledMajorEquip {
  navName: "HxStmHWLTemp"
}

// Hot water leaving temperature setpoint
UtahHxStmHWLTempSp: UtahHxSteam & HotWater & UtahWaterTempLeavingSp & UtahHisSampledMajorEquip {
  navName: "HxStmHWLTempSp"
}

////////////////////////////////////
// Steam Pressure
////////////////////////////////////

// Steam Pressure Sensor
UtahHxStmPress: UtahHxSteam & UtahSteamPressureSensor  & UtahHisSampledMajorEquip<abstract>{
  navName: "HxStmPress"
  unit: "psi"
    }
    
////////////////////////////////////
// Hot Water Valve
////////////////////////////////////

// Hot Water Isolation Valve
UtahHxStmHWIsoVlvCmd: UtahHxSteam & HotWater & UtahIsoValveCmd & UtahHisCov <abstract>{
  navName: "HxStmHWIsoVlvCmd"
    }

//////////////////////////////////////////////////////////////////////////
//  Hot Water Circulation Pumps
//////////////////////////////////////////////////////////////////////////

// Primary Hot water pump command
UtahHxStmHWCPCmd: UtahHxSteam & HotWater & UtahCPCmd & UtahHisCov {
  navName: "HxStmHWCPCmd"
}

// Primary Hot water pump command status
UtahHxStmHWCPCmdSts: UtahHxSteam & HotWater & UtahCPCmdSts & UtahHisCov {
  navName: "HxStmHWCPCmdSts"
}
