// Standalone humidifier equip — optional points

UtahHumidifier: HumidifierEquip {

  points: {
    humEnable: UtahHumidifierEnable?
    humCmd: UtahHumidifierCmd
    humSts: UtahHumidifierCmdSts?
    humOutput: UtahHumidifierOutput?
  }
}
