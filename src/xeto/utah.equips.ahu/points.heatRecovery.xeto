// Heat Recovery Water System Points - Temperatures, Flow, Power, Energy

//////////////////////////////////////////////////////////////////////////
// Heat Recovery Circ Pump
//////////////////////////////////////////////////////////////////////////

// Heat recovery water circ pump command
UtahHRWCPCmd: UtahHeatRecovery & UtahCPCmd & UtahHisCov {
  navName: "HRWCPCmd"
}

//////////////////////////////////////////////////////////////////////////
// Heat Recovery Coil Temperatures
//////////////////////////////////////////////////////////////////////////

// Heat recovery water entering temperature
UtahHRCWETemp: UtahHeatRecovery & UtahHeatRecoveryCoil & UtahWaterTempEntering & UtahHisSampledMajorEquip {
  navName: "HRCWETemp"
}

// Heat recovery water leaving temperature
UtahHRCWLTemp:  UtahHeatRecovery & UtahHeatRecoveryCoil & UtahWaterTempLeaving & UtahHisSampledMajorEquip {
  navName: "HRCWLTemp"
}

// Heat recovery coil air leaving temperature
UtahHRCALTemp: UtahHeatRecovery & UtahHeatRecoveryCoil & UtahAirTempLeaving & UtahHisSampledMajorEquip {
  navName: "HRCALTemp"
}

//////////////////////////////////////////////////////////////////////////
// Heat recovery valve
//////////////////////////////////////////////////////////////////////////

// Heat recovery valve position command (%)
UtahHRVlvPos: UtahHeatRecovery & UtahValvePos & UtahHisSampledMajorEquip {
  navName: "HRVlvPos"
}

// Heat recovery valve position feedback
UtahHRVlvPosSts: UtahHeatRecovery & UtahValvePosSts & UtahHisSampledMajorEquip {
  navName: "HRVlvPosSts"
}

//////////////////////////////////////////////////////////////////////////
// Heat recovery water flow
//////////////////////////////////////////////////////////////////////////

UtahHRWFlow: UtahHeatRecovery & WaterFlowSensor & UtahHisSampledMajorEquip {
  navName: "HRWFlow"
}

//////////////////////////////////////////////////////////////////////////
// Heat recovery water volumetric flow
//////////////////////////////////////////////////////////////////////////

UtahHRWVolFlow: UtahHeatRecovery & WaterVolumeSensor & UtahHisSampledMajorEquip {
  navName: "HRWVolFlow"
}

//////////////////////////////////////////////////////////////////////////
// Heat recovery water mass flow
//////////////////////////////////////////////////////////////////////////

UtahHRWMassFlow: UtahHeatRecovery & UtahWaterMassFlowSensor & UtahHisSampledMajorEquip {
  massFlow
  navName: "HRWMassFlow"
  unit: "lb/min"
}

//////////////////////////////////////////////////////////////////////////
// Heat recovery water power
/////////////////////////////////////////////// ///////////////////////////

UtahHRWPower:UtahHeatRecovery & UtahWaterPowerSensor & UtahHisSampledMajorEquip {
  navName: "HRWPower"
}
//////////////////////////////////////////////////////////////////////////
// Heat recovery water energy
//////////////////////////////////////////////////////////////////////////

UtahHRWEnergy: UtahHeatRecovery & UtahWaterEnergySensor & UtahHisSampledMajorEquip {
  navName: "HRWEnergy"
  unit: Unit <quantity:"energy"> "kWh" 
}
