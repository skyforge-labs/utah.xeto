// Hot Water Heating System Points - Pump, Valve, Temperatures

///////////////////////////////////////////
// Hot water valve position status
///////////////////////////////////////////

// Hot water valve position
UtahHWVlvPos: HotWater & UtahValvePos & UtahHisSampledMajorEquip {
  navName: "HWVlvPos"
}

UtahHWVlvPosSts: HotWater & UtahValvePosSts & UtahHisSampledMajorEquip {
  navName: "HWVlvPosSts"
}

///////////////////////////////////////////
// Heating coil water/air entering/leving temperature
///////////////////////////////////////////

UtahHWCWETemp: HotWater & UtahHeatingCoil & UtahWaterTempEntering & UtahHisSampledMajorEquip {
  navName: "HWCWETemp"
}

// Heating coil water leaving temperature
UtahHWCWLTemp: HotWater & UtahHeatingCoil & UtahWaterTempLeaving & UtahHisSampledMajorEquip {
  navName: "HCWLTemp"
}

// Heating coil air entering temperature
UtahHWCAETemp: HotWater & UtahHeatingCoil & UtahAirTempEntering & UtahHisSampledMajorEquip {
  navName: "HWCAETemp"
}

// Heating coil air leaving temperature
UtahHWCALTemp: HotWater & UtahHeatingCoil & UtahAirTempLeaving & UtahHisSampledMajorEquip {
  navName: "HWCALTemp"
}

///////////////////////////////////////////
// Hot water circulation pump command
///////////////////////////////////////////

// Hot water circulation pump status
UtahHWCPSts: HotWater & UtahCPCmdSts & UtahHisCov {
  navName: "HWCPSts"
}

///////////////////////////////////////////
// Hot water Electric Heating
///////////////////////////////////////////

// Legacy names (HotWater tag retained for existing tagged points)
UtahHWElecHtgCmd: HotWater & UtahElecCmd & UtahHisCov {
  heating
  navName: "HWElecHtgCmd"
}

UtahHWElecHtgCmdSts: HotWater & UtahElecCmdSts & UtahHisCov {
  heating
  navName: "HWElecHtgCmdSts"
}

// Preferred electric heat (no HotWater)
UtahElecHtgCmd: UtahElecCmd & UtahHisCov {
  heating
  navName: "ElecHtgCmd"
}

UtahElecHtgCmdSts: UtahElecCmdSts & UtahHisCov {
  heating
  navName: "ElecHtgSts"
}

UtahElecHtgPower: Elec & Power & NumberPoint & SensorPoint & UtahHisSampledMajorEquip {
  heating
  unit: Unit <quantity:"power"> "kW"
  navName: "ElecHtgPower"
}

UtahElecHtgLAT: Elec & UtahHeatingCoil & UtahAirTempLeaving & UtahHisSampledMajorEquip {
  navName: "ElecHtgLAT"
}

//////////////////////////////////////////////////////////////////////////
// Natural gas heat
//////////////////////////////////////////////////////////////////////////

UtahGasHtgCmd: NaturalGas & RunCmd & UtahHisCov {
  heating
  navName: "GasHtgCmd"
}

UtahGasHtgCmdSts: NaturalGas & RunSensor & UtahHisCov {
  heating
  navName: "GasHtgSts"
}

//////////////////////////////////////////////////////////////////////////
// Steam heat
//////////////////////////////////////////////////////////////////////////

UtahStmHtgVlvCmd: Steam & UtahHeatingCoil & UtahStmVlvCmd & UtahHisCov {
  navName: "StmHtgVlvCmd"
}

UtahStmHtgVlvPos: Steam & UtahHeatingCoil & UtahStmVlvPos & UtahHisSampledMajorEquip {
  navName: "StmHtgVlvPos"
}

UtahStmHtgLAT: Steam & UtahHeatingCoil & UtahAirTempLeaving & UtahHisSampledMajorEquip {
  navName: "StmHtgLAT"
}

UtahHtgCmd: HotWater & RunCmd & UtahHisCov {
  navName: "HtgCmd"
}

//////////////////////////////////////////////////////////////////////////
// Heating coil flow / DP / power / energy (AHU-scoped)
//////////////////////////////////////////////////////////////////////////

UtahHWCFlow: HotWater & UtahHeatingCoil & UtahWaterFlowSensor & UtahHisSampledMajorEquip {
  navName: "HWCFlow"
}

UtahHWCDP: HotWater & UtahHeatingCoil & UtahWaterDPSensor & UtahHisSampledMajorEquip {
  navName: "HWCDP"
}

UtahHWCPower: HotWater & UtahHeatingCoil & UtahWaterPowerSensor & UtahHisSampledMajorEquip {
  navName: "HWCPower"
}

UtahHWCEnergy: HotWater & UtahHeatingCoil & UtahWaterEnergySensor & UtahHisConsumptionMajorEquip {
  navName: "HWCEnergy"
}