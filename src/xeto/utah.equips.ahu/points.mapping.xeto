// Exhaust is distinct from relief; demand/availability is not actuator feedback.
UtahClgOutput: NumberPoint & CmdPoint & UtahHisSampledMajorEquip {
  cooling
  output
  unit: Unit <fixed> "%"
  navName: "ClgOutput"
}
UtahEffectiveOccCmd: UtahOccCmd {
  effective
  navName: "EffectiveOccupied"
}
// Leaving the AHU into the duct, never a substitute for a room RH sensor.
UtahDaHumSp: UtahDischarge & UtahAirHumiditySp & UtahHisCov {
  navName: "DaHumSp"
}
UtahEaFanCmd: UtahExhaust & UtahFanCmd & UtahHisCov {
  navName: "EaFanCmd"
  enum: Str?
}
// Exhaust feedback is not relief fan feedback or a requested command.
UtahEaFanCmdSts: UtahExhaust & UtahFanCmdSts & UtahHisCov { navName: "EaFanSts" }
UtahEaFanSpdSts: UtahExhaust & UtahFanSpdSts & UtahHisSampledMajorEquip { navName: "EaFanSpdSts" }
UtahEaDmprPos: UtahExhaust & UtahDamperPos & UtahHisSampledMajorEquip { navName: "EaDmprPos" }
UtahOaCO2: UtahOutside & UtahAirCo2Sensor & UtahHisSampledMajorEquip { navName: "OaCO2" }
UtahClgDemand: NumberPoint & CmdPoint & UtahHisSampledMajorEquip {
  cooling
  demand
  unit: Unit <fixed> "%"
  navName: "ClgDemand"
}
UtahHumidifierOutputCmd: UtahHumid & NumberPoint & CmdPoint & UtahHisSampledMajorEquip {
  output
  unit: Unit <fixed> "%"
  navName: "HumidifierOutputCmd"
}
// Electrical input power: the measured phenomenon is electricity, not air.
UtahDaFanElecPower: UtahElecPower & UtahHisSampledMajorEquip {
  fan
  discharge
  navName: "DaFanElecPower"
}
UtahRaFanElecPower: UtahElecPower & UtahHisSampledMajorEquip {
  fan
  return
  navName: "RaFanElecPower"
}
UtahAhuState: EnumPoint & SensorPoint & UtahHisCov {
  state
  enum: Str?
  navName: "AhuState"
}
UtahAhuHvacModeSts: EnumPoint & SensorPoint & UtahHisCov {
  hvac
  mode
  enum: Str?
  navName: "HvacModeSts"
}
UtahEconAvailable: BoolPoint & SensorPoint & UtahHisCov {
  economizing
  available
  enum: Str?
  navName: "EconAvailable"
}
UtahChWReturnTemp: ChilledWater & UtahWaterTempReturn & UtahHisSampledMajorEquip {
  navName: "ChWReturnTemp"
}
UtahHwDP: HotWater & UtahWaterDPSensor & UtahHisSampledMajorEquip {
  navName: "HwDP"
}
UtahPreheatPumpCmd: UtahCPCmd & UtahHisCov {
  preheat
  enum: Str?
  navName: "PreheatPumpCmd"
}
