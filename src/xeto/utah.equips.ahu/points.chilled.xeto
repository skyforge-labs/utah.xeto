// Chilled Water System Points - Valves, Coil Temperatures, Circ Pumps, Flow

//////////////////////////////////////////////////////////////////////////
// Valve Position Points
//////////////////////////////////////////////////////////////////////////

// Chilled water valve position
UtahChWVlvPos: ChilledWater & UtahValvePos & UtahHisSampledMajorEquip {
  navName: "ChWVlvPos"
}

// Chilled water valve position status
UtahChWVlvPosSts: ChilledWater & UtahValvePosSts & UtahHisSampledMajorEquip {
  navName: "ChWVlvPosSts"
}
//////////////////////////////////////////////////////////////////////////
// DX Cooling Points
//////////////////////////////////////////////////////////////////////////

// DX cooling point base
UtahDxClgPoint: UtahStagePoint <abstract> {
  cooling
  navName: "Dx cooling point"
}

// DX cooling stage command
UtahDxClgStageCmd: UtahDxClgPoint & UtahDxStageCmd & UtahHisCov {
  navName: "CCStageCmd"
}

// DX cooling stage command status
UtahDxClgStageCmdSts: UtahDxClgPoint & UtahDxStageCmdSts & UtahHisCov {
  navName: "CCStageSts"
}


//////////////////////////////////////////////////////////////////////////
// Coil Temperature Points
//////////////////////////////////////////////////////////////////////////

// Chilled water coil water entering temperature
UtahChWCWETemp: ChilledWater & UtahCoolingCoil & UtahWaterTempEntering & UtahHisSampledMajorEquip {
  navName: "ChWCWETemp"
}

// Chilled water coil water leaving temperature
UtahChWCWLTemp: ChilledWater & UtahCoolingCoil & UtahWaterTempLeaving & UtahHisSampledMajorEquip {
  navName: "ChWCWLTemp"
}

// Chilled water coil air entering temperature
UtahChWCAETemp: ChilledWater & UtahCoolingCoil & UtahAirTempEntering & UtahHisSampledMajorEquip {
  navName: "ChWCAETemp"
}

// Chilled water coil air leaving temperature
UtahChWCALTemp: UtahCoolingCoil & UtahAirTempLeaving & UtahHisSampledMajorEquip {
  navName: "ChWCALTemp"
}

// Chilled water coil air leaving temperature setpoint
UtahChWCALTempSp:  ChilledWater & UtahCoolingCoil & UtahAirTempLeavingSp & UtahHisCov {
  navName: "ChWCALTempSp"
}

//////////////////////////////////////////////////////////////////////////
// Coil Humidity Points
//////////////////////////////////////////////////////////////////////////

// Chilled water coil air leaving humidity
UtahChWCALHum: ChilledWater & UtahCoolingCoil & UtahAirHumidityLeavinging & UtahHisSampledMajorEquip {
  navName: "CCALHum"
}

UtahClgCmd: ChilledWater & RunCmd & UtahHisCov {
  navName: "ClgCmd"
}

//////////////////////////////////////////////////////////////////////////
// Cooling coil flow / DP / power / energy (AHU-scoped)
//////////////////////////////////////////////////////////////////////////

UtahChWCFlow: ChilledWater & UtahCoolingCoil & UtahWaterFlowSensor & UtahHisSampledMajorEquip {
  navName: "ChWCFlow"
}

UtahChWCDP: ChilledWater & UtahCoolingCoil & UtahWaterDPSensor & UtahHisSampledMajorEquip {
  navName: "ChWCDP"
}

UtahChWCPower: ChilledWater & UtahCoolingCoil & UtahWaterPowerSensor & UtahHisSampledMajorEquip {
  navName: "ChWCPower"
}

UtahChWCEnergy: ChilledWater & UtahCoolingCoil & UtahWaterEnergySensor & UtahHisConsumptionMajorEquip {
  navName: "ChWCEnergy"
}
