// DX Heating, Compressor, Reversing Valve, Condenser Fan, Condenser Water

//////////////////////////////////////////////////////////////////////////
// DX heating stages (mirrors UtahDxClg*)
//////////////////////////////////////////////////////////////////////////

UtahDxHtgPoint: UtahStagePoint <abstract> {
  heating
  navName: "Dx heating point"
}

UtahDxHtgStageCmd: UtahDxHtgPoint & UtahDxStageCmd & UtahHisCov {
  navName: "DxHtgStageCmd"
}

UtahDxHtgStageCmdSts: UtahDxHtgPoint & UtahDxStageCmdSts & UtahHisCov {
  navName: "DxHtgStageSts"
}

// Heating stage feedback (generic stage sensor)
UtahHtgStageSts: UtahStageCmdSts & UtahHisCov {
  heating
  navName: "HtgStageSts"
}

//////////////////////////////////////////////////////////////////////////
// DX coil leaving air temp
//////////////////////////////////////////////////////////////////////////

UtahDxCALTemp: UtahDischarge & UtahAirTempLeaving & UtahHisSampledMajorEquip {
  cooling
  navName: "DxCALTemp"
}

//////////////////////////////////////////////////////////////////////////
// Refrigerant compressor
//////////////////////////////////////////////////////////////////////////

UtahDxCompCmd: UtahCompressor & RunCmd & UtahHisCov {
  navName: "DxCompCmd"
}

UtahDxCompCmdSts: UtahCompressor & RunSensor & UtahHisCov {
  navName: "DxCompSts"
}

UtahDxCompCurrent: UtahCompressor & Elec & NumberPoint & SensorPoint & UtahHisSampledMajorEquip {
  unit: Unit <quantity:"electricCurrent"> "A"
  navName: "DxCompCurrent"
}

//////////////////////////////////////////////////////////////////////////
// Reversing valve
//////////////////////////////////////////////////////////////////////////

UtahDxRevVlvCmd: UtahReversingValve & UtahValveCmd & UtahHisCov {
  navName: "DxRevVlvCmd"
}

UtahDxRevVlvCmdSts: UtahReversingValve & UtahValveCmdSts & UtahHisCov {
  navName: "DxRevVlvSts"
}

//////////////////////////////////////////////////////////////////////////
// Condenser fan
//////////////////////////////////////////////////////////////////////////

UtahCondFanCmd: UtahCondenser & UtahFanCmd & UtahHisCov {
  navName: "CondFanCmd"
}

UtahCondFanCmdSts: UtahCondenser & UtahFanCmdSts & UtahHisCov {
  navName: "CondFanSts"
}

UtahCondFanCurrent: UtahCondenser & Elec & NumberPoint & SensorPoint & UtahHisSampledMajorEquip {
  unit: Unit <quantity:"electricCurrent"> "A"
  navName: "CondFanCurrent"
}

//////////////////////////////////////////////////////////////////////////
// Condenser water temps
//////////////////////////////////////////////////////////////////////////

UtahCWETemp: UtahCW & UtahWaterTempEntering & UtahHisSampledMajorEquip {
  navName: "CWETemp"
}

UtahCWLTemp: UtahCW & UtahWaterTempLeaving & UtahHisSampledMajorEquip {
  navName: "CWLTemp"
}
