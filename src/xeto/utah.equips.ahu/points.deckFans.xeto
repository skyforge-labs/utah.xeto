}

UtahCDFanSpdSts: UtahColdDeck & UtahFanSpdSts & UtahHisSampledMajorEquip {
  navName: "CDFanSpdSts"
}

UtahCDFanFreq: UtahColdDeck & UtahFanFreqSensor & UtahHisSampledMajorEquip {
  navName: "CDFanFreq"
}

UtahCDFanPower: UtahColdDeck & UtahFanPowerPoint & UtahHisSampledMajorEquip {
  navName: "CDFanPower"
}

