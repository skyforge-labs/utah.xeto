//
// Concrete, equipment-agnostic occupancy points built from the abstract
// occupancy point types defined in `points.occupancy.xeto`.
//
// Note: these are intentionally suffixed with "G36" (like `UtahAhuG36`) to
// make it clear they are a specific concrete profile built from the abstract
// Utah occupancy points.
//

//////////////////////////////////////////////////////////////////////////
// Occupancy Sensor
//////////////////////////////////////////////////////////////////////////

// Generic occupancy sensor (occupied/unoccupied)
UtahOccupiedSensorPointG36: UtahOccupiedSensorPoint & UtahHisCov {
  navName: "Occ"
}

//////////////////////////////////////////////////////////////////////////
// Occupancy Mode
//////////////////////////////////////////////////////////////////////////

// Generic occupancy mode (Occupied/Unoccupied/Standby/Bypass)
UtahOccupiedModePointG36: UtahOccupiedModePoint & UtahHisCov {
  navName: "OccMode"
  enum: Str? "Occupied,Unoccupied,Standby,Bypass"
}

