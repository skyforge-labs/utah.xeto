// Abstract Base Cooling Tower with all possible points (optional)
UtahCoolingTower: ChilledWaterPlant {

  chilledWaterPlantRef: Ref?
  coolingTower

  points: {
    // General Points
    enab:       UtahCTEnab?
    
// Outside Air Temps
    oaTemp:       UtahOaTemp?
    oaWBTemp:     UtahOaWetBulbTemp?
    oaDewPTemp:   UtahOaDewPointTemp?
    
// Condenser Water
    cwETemp:    UtahCTCWETemp?
    cwLTemp:    UtahCTCWLTemp
    
// Sump
    sumpTemp:   UtahSumpTemp?
    sumpHtrCmd: UtahSumpHtrCmd?
    sumpHtrSts: UtahSumpHtrCmdSts?
    
// Fans
    fanEnab:    UtahCTFanEnab?
    fanCmd:     UtahCTFanCmd?
    fanCmdSts:  UtahCTFanCmdSts?
    fanSpd:     UtahCTFanSpd?
    fanSpdSts:  UtahCTFanSpdSts?
    fanVFDFreq: UtahCTFanFreq?
    fanVFDPower:  UtahCTFanPower?  
    fanVFDEnergy: UtahCTFanEnergy?

//  Circ Pumps
    cpEnab:      UtahCTCPEnab?
    cpCmd:       UtahCTCPCmd?
    cpCmdSts:    UtahCTCPCmdSts?
    cpSpd:       UtahCTCPSpd?
    cpSpdSts:    UtahCTCPSpdSts?
    cpVFDFreq:   UtahCTCPFreq?
    cpPower:     UtahCTCPPower?
    cpEnergy:    UtahCTCPEnergy?

// Valves
    mkupWVlvCmd: UtahCTMkupWVlvCmd?
    isoVlvCmd:   UtahCTIsoVlvCmd?
    isoVlvCmdSts: UtahCTIsoVlvCmdSts?
    bypVlvCmd:   UtahCTBypVlvCmd?
    bypVlvCmdSts: UtahCTBypVlvCmdSts?
    bypVlvPos:   UtahCTBypVlvPos?
    bypVlvPosSts: UtahCTBypVlvPosSts?
  }
}