// Chilled Water System Points - Valves, Coil Temperatures, Circ Pumps, Flow

//////////////////////////////////////////////////////////////////////////
// Isolation Valve Points
//////////////////////////////////////////////////////////////////////////

// Chilled water isolation valve position
UtahChWIsoVlvPos: ChilledWater & UtahIsoValvePos & UtahHisSampledMajorEquip {
  isolation
  navName: "ChWIsoVlvPos"
}

// Chilled water isolation valve position status
UtahChWIsoVlvPosSts: ChilledWater & UtahIsoValvePosSts & UtahHisCov {
  isolation
  navName: "ChWIsoVlvPosSts"
}

//////////////////////////////////////////////////////////////////////////
// Chilled Water Temperature Points
//////////////////////////////////////////////////////////////////////////

// Chilled water entering temperature
UtahChWETemp: ChilledWater & UtahWaterTempEntering & UtahHisSampledMajorEquip {
  navName: "ChWETemp"
}

// Chilled water leaving temperature
UtahChWLTemp: ChilledWater & UtahWaterTempLeaving & UtahHisSampledMajorEquip {
  navName: "ChWLTemp"
}

// Chilled water leaving temperature setpoint
UtahChWLTempSp: ChilledWater & UtahWaterTempLeavingSp & UtahHisCov {
  navName: "ChWLTempSp"
}

//////////////////////////////////////////////////////////////////////////
// Chilled Water Diff Pressure Points
//////////////////////////////////////////////////////////////////////////

// Chilled Water Diff Pressure
UtahChWDP: ChilledWater & UtahWaterDPSensor & UtahHisSampledMajorEquip {
  navName: "ChWDP"
}
