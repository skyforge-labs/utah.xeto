// General Chiller Points - Enable, Command, Energy

//////////////////////////////////////////////////////////////////////////
// General Chiller Points
//////////////////////////////////////////////////////////////////////////

// Chiller Enabled
UtahChlrEnab: UtahChlr & EnableCmd & UtahHisCov {
  navName: "ChlrEnab"
}

// Chiller Run Cmd
UtahChlrCmd: UtahChlr & RunCmd & UtahHisCov {
  navName: "ChlrCmd"
}

// Chiller Run Status
UtahChlrCmdSts: UtahChlr & RunSensor & UtahHisCov {
  navName: "ChlrCmdSts"
}

// Emergency kill switch for Chiller shutdown
UtahChlrKillSwitch: UtahChlr & RunCmd & UtahHisCov {
  killSwitch
  navName: "ChlrKillSwitch"
}

// Chiller Load
UtahChlrLoad: UtahChlr & UtahLoadSensor & UtahHisSampledMajorEquip {
  navName: "ChlrLoad"
  unit: Unit <fixed> "%"
}

//  Chiller Tons
UtahChlrTons: UtahChlr & UtahTonsSensor & UtahHisSampledMajorEquip {
  navName: "ChlrTons"
  unit: Unit <quantity:"power"> "tonref"
}

// Chiller Power
UtahChlrPower: UtahChlr & Power & NumberPoint & SensorPoint & UtahHisSampledMajorEquip {
  navName: "ChlrPower"
  unit: Unit <quantity:"power"> "kW"
}

// Chiller Energy
UtahChlrEnergy: UtahChlr & Energy & NumberPoint & SensorPoint & UtahHisConsumptionMajorEquip {
  navName: "ChlrEnergy"
  unit: Unit <quantity:"energy"> "kWh"
}
