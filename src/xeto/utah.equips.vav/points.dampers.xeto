//  Zone Damper points

UtahDaDamperPos: UtahDischarge & UtahDamperPos & UtahHisSampledDefault {
    navName: "DmprPos"
}

UtahDaDamperCmd: UtahDischarge & UtahDamperCmd & UtahHisCov {
    navName: "DmprCmd"
}

// Actual feedback, distinct from the existing percentage/Boolean commands.
UtahDaDamperPosSts: UtahDischarge & UtahDamperPosSts & UtahHisSampledDefault {
    navName: "DmprPosSts"
}

UtahDaDamperCmdSts: UtahDischarge & UtahDamperCmdSts & UtahHisCov {
    navName: "DmprCmdSts"
}
