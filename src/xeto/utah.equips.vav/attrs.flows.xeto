DesignFlowAttr: NumberAttr <abstract> {
  equipRef: Ref <of:Vav>
  val: Number <unit:"cfm", quantity:Flow>
  design
  flow
}

DesignMinFlowAttr: DesignFlowAttr { min }
DesignMaxFlowAttr: DesignFlowAttr { max }

DesignMaxFlowCoolingAttr: DesignFlowAttr { max, cooling }
DesignMinFlowCoolingAttr: DesignFlowAttr { min, cooling }

DesignMaxFlowHeatingAttr: DesignFlowAttr { max, heating }
DesignMinFlowHeatingAttr: DesignFlowAttr { min, heating }

