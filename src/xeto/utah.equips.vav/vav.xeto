UtahVav: Vav {
  terminalUnit 
  airRef: MultiRef?<of:Ahu>
  siteRef: Ref<of:Site>
  navName: Str

  points: {

    occ: UtahZoneOccupiedSensor?
    occCmd: UtahZoneOccupiedCmd?
    effectiveOccCmd: UtahVavEffectiveOccupiedCmd?
    clgOutput: UtahVavClgOutput?
    occMode: UtahZoneOccupiedMode?
    hvacMode: UtahZoneAirHvacModeSp?

    daFlow: UtahZoneDaFlow
    daFlowSp: UtahZoneDaFlowSp?
    daFlowSpCov: UtahZoneDaFlowSpCov?
    daFlowSpMax: UtahZoneDaFlowSpMax?
    daFlowSpMin: UtahZoneDaFlowSpMin?
    daFlowOvrd: UtahDischargeAirFlowOvrd?
    daFlowPctOvrd: UtahDischargeAirFlowPercentOvrd?
    daFlowOvrdState: UtahDischargeAirFlowOvrdState?

    dmprPos: UtahDaDamperPos
    dmprCmd: UtahDaDamperCmd?
    dmprPosSts: UtahDaDamperPosSts?
    dmprCmdSts: UtahDaDamperCmdSts?
    dmprPosOvrd: UtahDmprPosOvrd?

    reheatVlvPos: UtahReheatValvePos
    reheatVlvPosSts: UtahReheatValvePosSts?
    reheatVlvCmd: UtahReheatValveCmd?
    reheatVlvPosOvrd: UtahReheatValvePosOvrd?

    // Optional multi-stream terminal points; does not assert venturi hardware.
    saFlow: UtahVavSaFlow?
    saFlowSp: UtahVavSaFlowSp?
    eaFlow: UtahVavEaFlow?
    raFlow: UtahVavRaFlow?
    saValvePos: UtahVavSaValvePos?
    eaValvePos: UtahVavEaValvePos?
    raValvePos: UtahVavRaValvePos?
    saOccFlowSp: UtahVavSaOccFlowSp?
    saUnoccFlowSp: UtahVavSaUnoccFlowSp?
    eaOccFlowSp: UtahVavEaOccFlowSp?
    eaUnoccFlowSp: UtahVavEaUnoccFlowSp?
    raOccFlowSp: UtahVavRaOccFlowSp?
    raUnoccFlowSp: UtahVavRaUnoccFlowSp?

    daTemp: UtahZoneDaTemp
    inletTemp: UtahVavInletTemp?
    daTempSp: UtahZoneDaTempSp?
    spcTemp: UtahZoneTemp
    spcTempSp: UtahZoneTempSpEff?
    spcTempOvrd: UtahSpcTempOvrd?

    occCoolSp: UtahOccCoolSp?
    occHeatSp: UtahOccHeatSp?
    unoccCoolSp: UtahUnoccCoolSp?
    unoccHeatSp: UtahUnoccHeatSp?
    stbyCoolSp: UtahStandbyCoolingSp?
    stbyHeatSp: UtahStandbyHeatingSp?

    coolEffSp: UtahZoneTempSpEffClg?
    heatEffSp: UtahZoneTempSpEffHtg?

    spcHum: UtahZoneAirHumiditySensor?
    spcHumidifySp: UtahZoneAirHumidifySp?
    spcDehumSp: UtahZoneAirDehumidifySp?

    spcCO2: UtahZoneCo2Sensor?
    spcCO2Sp: UtahZoneCo2Sp?

    zonePress: UtahZoneAirPress?
    zonePressSp: UtahZoneAirPressSp?

   // Commissioning Points
    coolFlowSp: UtahZoneDaFlowSpClgCov?
    coolMaxFlow: UtahZoneDaFlowSpClgMax?
    coolMinFlow: UtahZoneDaFlowSpClgMin?
    heatFlowSp: UtahZoneDaFlowSpHtgCov?
    heatMaxFlow: UtahZoneDaFlowSpHtgMax?
    heatMinFlow: UtahZoneDaFlowSpHtgMin?
    reheatFlowSp: UtahZoneDaFlowSpRH?
    reheatMaxFlow: UtahZoneDaFlowSpRHMax?
    reheatMinFlow: UtahZoneDaFlowSpRHMin?
    coolUnoccMaxFlow: UtahZoneDaFlowSpClgUnoccMax?
    coolUnoccMinFlow: UtahZoneDaFlowSpClgUnoccMin?
    heatUnoccMaxFlow: UtahZoneDaFlowSpHtgUnoccMax?
    heatUnoccMinFlow: UtahZoneDaFlowSpHtgUnoccMin?
    stbyFlowSp: UtahZoneDaFlowSpStandby?

    load: UtahHvacLoad?
    bypTime: UtahBypassTime?

    // Fan Powered Box Points
    fanCmd: UtahZoneFanCmd?
    fanEnab: UtahZoneFanEnab?
    fanModeCmd: UtahZoneFanModeCmd?
    fanSpd: UtahZoneFanSpd?
    fanSts: UtahZoneFanCmdSts?
    fanSpdSts: UtahZoneFanSpdSts?
    fanSpdHigh: UtahFanSpdHighCmd?
    fanSpdMed: UtahFanSpdMedCmd?
    fanSpdLow: UtahFanSpdLowCmd?
  }

  attrs: Query <of:Attr, inverse:"utah::UtahEquip.attrs">{
    designMinFlow: DesignMinFlowAttr?
    designMaxFlow: DesignMaxFlowAttr?
    designMaxFlowCooling: DesignMaxFlowCoolingAttr?
    designMaxFlowHeating: DesignMaxFlowHeatingAttr?
  }
}
