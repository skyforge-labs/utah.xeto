// Concrete meter point specs (common totals/measurements) shared by meter equips.

////////////////////////////////////////////////////
// Thermal / hydronic (BTU) meter points
////////////////////////////////////////////////////

// Cumulative thermal energy through the loop.
UtahMeterThermalEnergy: UtahWaterEnergySensor & UtahHisConsumptionMajorEquip {
  navName: "ThermalEnergy"
  unit: Unit <quantity:"energy"> "MMBTU"
}

// Instantaneous thermal power (heat rate).
UtahMeterThermalPower: UtahWaterPowerSensor & UtahHisSampledMajorEquip {
  navName: "ThermalPower"
  unit: Unit <quantity:"power"> "MMBTU/h"
}

// Volumetric water flow.
UtahMeterWaterFlow: UtahWaterFlowSensor & UtahHisSampledMajorEquip {
  navName: "WaterFlow"
}

// Loop entering water temperature.
UtahMeterEnteringWaterTemp: UtahWaterTempEntering & UtahHisSampledMajorEquip {
  navName: "EnteringWaterTemp"
}

// Loop leaving water temperature.
UtahMeterLeavingWaterTemp: UtahWaterTempLeaving & UtahHisSampledMajorEquip {
  navName: "LeavingWaterTemp"
}

////////////////////////////////////////////////////
// Water utility meter points
////////////////////////////////////////////////////

// Cumulative water consumption.
UtahMeterWaterVolume: UtahWaterVolumeSensor & UtahHisConsumptionMajorEquip {
  navName: "WaterVolume"
}

////////////////////////////////////////////////////
// Natural gas meter points
////////////////////////////////////////////////////

// Cumulative gas energy consumption.
UtahMeterGasEnergy: UtahNatGasEnergySensor & UtahHisConsumptionMajorEquip {
  navName: "GasEnergy"
  unit: Unit <quantity:"energy"> "MMBTU"
}

// Cumulative gas volume consumption.
UtahMeterGasVolume: UtahNatGasVolumeSensor & UtahHisConsumptionMajorEquip {
  navName: "GasVolume"
  unit: Unit <quantity:"volume"> "Ccf"
}

// Volumetric gas flow (no standard Ccf/h unit; left unitless per boiler precedent).
UtahMeterGasFlow: UtahNatGasFlowSensor & UtahHisSampledMajorEquip {
  navName: "GasFlow"
}
