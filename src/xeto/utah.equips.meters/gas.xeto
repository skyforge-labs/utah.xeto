// Generic natural gas meters.

// Natural gas utility/site flow meter (e.g. BLRGAS1, site gas meter).
UtahNatGasMeter: UtahUtilityMeter & NaturalGasMeter {
  points: {
    energy: UtahMeterGasEnergy?
    volume: UtahMeterGasVolume
    flow: UtahMeterGasFlow?
  }
}
