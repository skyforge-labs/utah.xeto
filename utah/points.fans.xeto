// Utah Abstract points

//////////////////////////////////////////
// Fan Enable
//////////////////////////////////////////

// Generic Fan enable
UtahFanEnab: UtahFan <abstract> {
    enable
}

// Generic Fan enable: Bool
UtahFanEnabPoint: UtahFanEnab & BoolPoint <abstract>{
}

// Generic Fan enable cmd
UtahFanEnabCmd: UtahFanEnabPoint & RunCmd <abstract>{
}

//////////////////////////////////////////
// Fan On/Off Bool
//////////////////////////////////////////

// Generic Fan cmd: Bool
UtahFanCmdPoint: UtahFan & BoolPoint <abstract>{
}

// On/Off cmd
UtahFanCmd: UtahFanCmdPoint & RunCmd <abstract>{
}

// On/Off cmd feedback status sensor
UtahFanCmdSts: UtahFanCmdPoint & RunSensor <abstract>{
}

//////////////////////////////////////////
//  Fan Speed Number
//////////////////////////////////////////

// Generic Fan speed 0-100%
UtahFanSpdPoint: UtahFan & NumberPoint <abstract>{
    speed
    unit: Unit <invariant> "%"
}

// 0-100% fan speed
UtahFanSpd: UtahFanSpdPoint & CmdPoint <abstract>{
}

// 0-100% valve feedback status sensor
UtahFanSpdSts: UtahFanSpdPoint & SensorPoint <abstract>{
}

//////////////////////////////////////////
//  Fan Mode
//////////////////////////////////////////

// Generic Fan mode off/High/Med/Low
UtahFanModePoint: UtahFan & EnumPoint <abstract>{
    mode
}

// Generic Fan mode off/High/Med/Low
UtahFanModeCmd: UtahFanModePoint & CmdPoint <abstract>{
}

//////////////////////////////////////////
//  Zone / terminal discharge fan
//////////////////////////////////////////

UtahZoneFanCmd: UtahZone & UtahFanCmd & UtahHisCov {
    navName: "FanCmd"
}

UtahZoneFanCmdSts: UtahZone & UtahFanCmdSts & UtahHisCov {
    navName: "FanSts"
}

// Zone / FPB fan enable
UtahZoneFanEnab: UtahZone & UtahFanEnabCmd & UtahHisCov {
    navName: "FanEnab"
}

UtahZoneFanModeCmd: UtahZone & UtahFanModeCmd & UtahHisCov {
    navName: "FanMode"
}

UtahZoneFanSpd: UtahZone & UtahFanSpd & UtahHisCov {
    navName: "FanSpd"
}

UtahZoneFanSpdSts: UtahZone & UtahFanSpdSts & UtahHisSampledDefault {
    navName: "FanSpdSts"
}

//////////////////////////////////////////
//  Fan Frequency
//////////////////////////////////////////

// Fan Frequency
UtahFanFreq: UtahFan <abstract> {
  freq
}

// Fan Frequency Point
UtahFanFreqPoint: UtahFanFreq & NumberPoint <abstract>{
    unit: "Hz"
}

    // Fan Frequency Sensor
UtahFanFreqSensor: UtahFanFreqPoint & SensorPoint <abstract>{
    unit: Unit <quantity:"frequency"> "Hz"
}

//////////////////////////////////////////
//  Fan Power
//////////////////////////////////////////

// Fan Power. Typically from VRF
UtahFanPowerPoint: UtahFan & NumberPoint & SensorPoint <abstract> {
  power
  unit: Unit <quantity:"power"> "kW"
}

//////////////////////////////////////////
//  FAn Energy
//////////////////////////////////////////

// Fan Energy. Typically from VRF
UtahFanEnergyPoint: UtahFan & NumberPoint & SensorPoint <abstract> {
  energy
  unit: Unit <quantity:"energy"> "kWh"
}

//////////////////////////////////////////
//  Fan Alarm
//////////////////////////////////////////

// Fan Alarm
UtahFanAlarmPoint: UtahFan & AlarmSensor <abstract>{
}
