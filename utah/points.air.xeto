////////////////////////////////////
// Utah Abstract points
////////////////////////////////////
// Air Temperatures generic
////////////////////////////////////

// Air Temperature
UtahAirTemp: PhEntity <abstract> {
  air
  temp
}

// Air Temperature Point
UtahAirTempPoint: UtahAirTemp & NumberPoint <abstract>{
    unit: Unit <quantity:"temperature"> "°F"
}

// Air Temperature Sensor
UtahAirTempSensor: UtahAirTempPoint & SensorPoint <abstract>{
}

 // Air Temperature Setpoint
UtahAirTempSp: UtahAirTempPoint & SpPoint <abstract>{
}

///////////////////////////////////////
// Outside air temperature
///////////////////////////////////////

UtahOaTemp: UtahOutside & UtahAirTempSensor & UtahHisSampledDefault  {
    navName: "OaTemp"
    color: Str? "lightblue"
}

UtahOaWetBulbTemp: UtahOutside & UtahAirTempSensor & UtahHisSampledDefault {
    wetBulb
    navName: "OaWBTemp"
    color: Str? "royalblue"
}

UtahOaDewPointTemp: UtahOutside & UtahAirTempSensor & UtahHisSampledDefault {
    dewPoint
    navName: "OaDewPTemp"
    color: Str? "navy"
}

/////////////////////////////////////////
//  Zone Temperatures and setpoints
/////////////////////////////////////////

//  Zone Temperature
UtahZoneTemp: UtahZone & UtahAirTempSensor & UtahHisSampledDefault {
    navName: "ZoneTemp"
    color: Str? "gray"
}

// Zone temperature setpoint
UtahZoneTempSp: UtahZone & UtahAirTempSp & UtahHisCov {
    navName: "ZoneTempSp"
    color: Str? "darkGreen"
    strokeDasharray: Str? "2,2"
}

// Zone temperature effective setpoint
UtahZoneTempSpEff: UtahZoneTempSp & UtahHisCov {
    effective
    navName: "ZoneTempSp"
    color: Str? "green"
    strokeDasharray: Str? "2,2"
}

// Zone temperature effective setpoint
UtahZoneTempSpEffClg: UtahZoneTempSp & UtahHisCov {
    effective
    cooling
    navName: "ZoneTempSpClg"
    color: Str? "olive"
    strokeDasharray: Str? "2,2"
}

// Zone temperature effective setpoint
UtahZoneTempSpEffHtg: UtahZoneTempSp & UtahHisCov {
    effective
    heating
    navName: "ZoneTempSpHtg"
    color: Str? "darkgreen"
    strokeDasharray: Str? "2,2"
}

// Zone Occupied cooling setpoint
UtahOccCoolSp: UtahZoneTempSp & UtahOccupied & UtahHisCov {
    cooling
    navName: "OccCoolSp"
    color: Str? "Green"
}

// Zone Occupied heating setpoint
UtahOccHeatSp: UtahZoneTempSp & UtahOccupied & UtahHisCov {
    heating
    navName: "OccHeatSp"
    color: Str? "LightGreen"
}

// Zone Unoccupied cooling setpoint
UtahUnoccCoolSp: UtahZoneTempSp & UtahUnoccupied &  UtahHisCov {
    cooling
    navName: "UnoccCoolSp"
    color: Str? "olive"
}

// Zone Unoccupied heating setpoint
UtahUnoccHeatSp: UtahZoneTempSp & UtahUnoccupied & UtahHisCov {
    heating
    navName: "UnoccHeatSp"
    color: Str? "DarkGreen"
}

// Zone Standby Cooling setpoint
UtahStandbyCoolingSp: UtahZoneTempSp & UtahStandby & UtahHisCov {
    cooling
    navName: "StbyCoolSp"
}

// Zone Standby Heating setpoint
UtahStandbyHeatingSp: UtahZoneTempSp & UtahStandby & UtahHisCov {
    heating
    navName: "StbyHeatSp"
}

/////////////////////////////////////////
//  Zone discharge air (shared terminals)
/////////////////////////////////////////

// Zone DAT — VAV / HP terminal / FCU / etc.
UtahZoneDaTemp: UtahZone & UtahDischarge & UtahAirTempSensor & UtahHisSampledDefault {
    navName: "DaTemp"
    color: Str? "purple"
}

UtahZoneDaTempSp: UtahZone & UtahDischarge & UtahAirTempSp & UtahHisCov {
    navName: "DaTempSp"
    color: Str? "purple"
}

UtahZoneDaFlow: UtahZone & UtahDischarge & UtahAirFlowSensor & UtahHisSampledDefault {
    navName: "DaFlow"
    color: Str? "purple"
}

UtahZoneDaFlowSp: UtahZone & UtahDischarge & UtahAirFlowSp & UtahHisSampledDefault {
    navName: "DaFlowSp"
    color: Str? "green"
    strokeDasharray: Str? "2,2"
}

/////////////////////////////////////////
//  Zone air quality (shared terminals)
/////////////////////////////////////////

UtahZoneAirHumiditySensor: UtahZone & UtahAirHumiditySensor & UtahHisSampledDefault {
    navName: "SpcHum"
}

UtahZoneAirHumidifySp: UtahZone & UtahAirHumidifySp & UtahHisCov {
    hisMode: "cov"
}

UtahZoneAirDehumidifySp: UtahZone & UtahAirDehumidifySp & UtahHisCov {
    hisMode: "cov"
}

UtahZoneCo2Sensor: UtahZone & UtahAirCo2Sensor & UtahHisSampledDefault {
    navName: "SpcCO2"
}

UtahZoneCo2Sp: UtahZone & UtahAirCo2Sp & UtahHisSampledDefault {
    navName: "SpcCO2Sp"
}

/////////////////////////////////////////
//  Misc Air Temperatures
/////////////////////////////////////////

// Air Temperature entering a device
UtahAirTempEntering: UtahAirTempSensor <abstract>{
    entering
    color: Str "lightblue"
}

// Air Temperature leaving a device
UtahAirTempLeaving: UtahAirTempSensor <abstract>{
    leaving
    color: Str "blue"
}

// Air Temperature leaving a device setpoint
UtahAirTempLeavingSp: UtahAirTempSp <abstract>{
    leaving
    color: Str "green"
}

////////////////////////////////////
// Air Humidity
////////////////////////////////////

// Air Humidity
UtahAirHumidity: PhEntity <abstract> {
  air
  humidity
}

// Air Humidity Sensor
UtahAirHumidityPoint: UtahAirHumidity & NumberPoint <abstract>{
    unit: Unit <invariant> "%RH"
}

// Air Humidity Sensor
UtahAirHumiditySensor: UtahAirHumidityPoint & SensorPoint <abstract>{
}

// Air Humidity Setpoint
UtahAirHumiditySp: UtahAirHumidityPoint & SpPoint <abstract>{
}

// Air Temperature leaving a device
UtahAirHumidityLeavinging: UtahAirHumiditySensor <abstract>{
    leaving
}

////////////////////////////////////
// Air Dehumidify
////////////////////////////////////

// Air Dehumidify
UtahAirDehumidify: UtahDehumidify <abstract> {
  air
}

// Air Dehumidify point
UtahAirDehumidifyPoint: UtahAirDehumidify & NumberPoint <abstract>{
    unit: Unit <invariant> "%RH"
}

// Air Dehumidify setpoint
UtahAirDehumidifySp: UtahAirDehumidifyPoint & SpPoint <abstract>{
}

////////////////////////////////////
// Air Humidify
////////////////////////////////////

// Air Humidify
UtahAirHumidify: UtahHumidify <abstract> {
  air
}

// Air Humidify setpoint
UtahAirHumidifyPoint: UtahAirHumidify & NumberPoint <abstract>{
    unit: Unit <invariant> "%RH"
}

// Air Humidify setpoint
UtahAirHumidifySp: UtahAirHumidifyPoint & SpPoint <abstract>{
}

////////////////////////////////////
// Air Flow
////////////////////////////////////

// Generic Air Flow
// ph 5.0: Flow renamed to VolumetricFlow
UtahAirFlow: PhEntity <abstract> {
  air
  flow
}

// Generic Air FlowPoint
UtahAirFlowPoint: UtahAirFlow & NumberPoint <abstract>{
    unit: Unit <quantity:"volumetricFlow"> "cfm"
}

// Generic Air Flow
UtahAirFlowSensor: UtahAirFlowPoint & SensorPoint <abstract>{
}

// Generic Air Flow Setpoint
UtahAirFlowSp: UtahAirFlowPoint & SpPoint <abstract>{
}

UtahAirFlowSpClg: UtahAirFlowSp <abstract> {
    cooling
    navName: "AirFlowSpClg"
}

UtahAirFlowSpHtg: UtahAirFlowSp <abstract> {
    heating
    navName: "AirFlowSpHtg"
}

////////////////////////////////////
// Air Pressure
////////////////////////////////////

// Generic Air Pressure
UtahAirPressure: PhEntity <abstract> {
  air
  pressure
}

// Generic Air Pressure
UtahAirPressurePoint: UtahAirPressure & NumberPoint <abstract>{
    unit: Unit <quantity:"pressure"> "inH₂O"
    precision: 0.01
}

// Generic Air Pressure
UtahAirPressureSensor: UtahAirPressurePoint & SensorPoint <abstract>{
}

// Generic Air Pressure Setpoint
UtahAirPressureSp: UtahAirPressurePoint & SpPoint <abstract>{
}

// Generic Air Pressure Alarm
UtahAirPressureAlarmPoint: UtahAirPressure & AlarmSensor <abstract>{
}

////////////////////////////////////
// Air Differential Pressure
////////////////////////////////////

// Generic Air Differential Pressure
UtahAirDiffPressure: PhEntity <abstract> {
  air
  pressure
  // differential via subclass markers/units
}

// Generic Air Differential Pressure
UtahAirDiffPressurePoint: UtahAirDiffPressure & NumberPoint & SensorPoint <abstract>{
    unit: Unit <quantity:"pressure"> "inH₂O"
    precision: 0.01
}

// Overall filter differential pressure (shared; not AHU-only)
UtahFilterDP: UtahAirFilter & UtahAirDiffPressurePoint & SensorPoint & UtahHisSampledMajorEquip {
  navName: "FilterDP"
}

////////////////////////////////////
// Air Co2
////////////////////////////////////

// Generic Air Co2
UtahAirCo2: PhEntity <abstract> {
  air
  co2
}

// Generic Air Co2 Point
UtahAirCo2Point: UtahAirCo2 & NumberPoint <abstract>{
    unit: Unit <invariant> "ppm"
}

// Generic Air Co2 Sensor
UtahAirCo2Sensor: UtahAirCo2Point & SensorPoint <abstract>{
}

// Generic Air Co2 Setpoint
UtahAirCo2Sp: UtahAirCo2Point & SpPoint <abstract>{
}
