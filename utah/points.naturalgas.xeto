// Natural Gas Flow
// ph 5.0: Flow renamed to VolumetricFlow
UtahNatGasFlow: PhEntity <abstract> {
  naturalGas
  flow
}

// Natural Gas Flow Point
UtahNatGasFlowPoint: UtahNatGasFlow & NumberPoint <abstract>{

    }

// Natural Gas Flow Sensor
UtahNatGasFlowSensor: UtahNatGasFlowPoint & SensorPoint <abstract>{

    }

