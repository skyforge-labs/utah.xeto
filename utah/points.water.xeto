// Utah Water Abstract points
////////////////////////////////////////////////////
// Heat Recovery
////////////////////////////////////////////////////

UtahHeatRecoveryWater: UtahHeatRecovery <abstract> {
  water
}

////////////////////////////////////////////////////
// Water Flow
////////////////////////////////////////////////////

// Water Flow
// ph 5.0: Flow renamed to VolumetricFlow
UtahWaterFlow: PhEntity <abstract> {
  water
  flow
}

// Water Flow Point
UtahWaterFlowPoint: NumberPoint & UtahWaterFlow <abstract>{
    unit: Unit <quantity:"volumetricFlow"> "gal/min"
    }

// Water Flow Sensor
UtahWaterFlowSensor: UtahWaterFlowPoint & SensorPoint <abstract>{

    }

// Water Flow Sp
UtahWaterFlowSp: UtahWaterFlowPoint & SpPoint <abstract>{

    }

////////////////////////////////////////////////////
// Water Makeup
////////////////////////////////////////////////////

//UtahWaterMakeup: Water  <abstract> {
//    makeup
//    doc: "Makeup Water"
//    }

////////////////////////////////////////////////////
// Water Pressure & Diff Press
////////////////////////////////////////////////////

// Water Pressure
UtahWaterPress: PhEntity <abstract> {
  water
  pressure
}

// Water Pressure Point
UtahWaterPressPoint: UtahWaterPress & NumberPoint <abstract>{
    unit: Unit <quantity:"pressure"> "psi"
    }

// Water Pressure Sensor
UtahWaterPressSensor: UtahWaterPressPoint & SensorPoint <abstract>{

    }

// Water Pressure Setpoint
UtahWaterPressSp: UtahWaterPressPoint & SpPoint <abstract>{

    }

//  Water pressure delta
// Water Pressure Delta
UtahWaterDP: UtahWaterPress <abstract>{
    delta
    }

// Water Pressure Delta Point
UtahWaterDPPoint: UtahWaterDP & NumberPoint <abstract>{
    unit: Unit <quantity:"pressure"> "psi"
    }

// Water Pressure Delta Sensor
UtahWaterDPSensor: UtahWaterDPPoint & SensorPoint <abstract>{

    }

// Water Pressure Delta Setpoint
UtahWaterDPSp: UtahWaterDPPoint & SpPoint <abstract>{

    }

////////////////////////////////////////////////////
// Water Mass
////////////////////////////////////////////////////

// Water Mass for flow points
// ph 5.0: Flow renamed to VolumetricFlow
UtahWaterMassFlow: PhEntity <abstract> {
  water
  flow
  massFlow
}

// Water Mass for flow point
UtahWaterMassFlowPoint: UtahWaterMassFlow & NumberPoint <abstract>{
    unit: Unit <quantity:"massFlow"> "lb/min"

}

// Water Mass for flow sensor
UtahWaterMassFlowSensor: UtahWaterMassFlowPoint & SensorPoint <abstract>{
}

////////////////////////////////////////////////////
// Water Volume
////////////////////////////////////////////////////

// Water Volume
UtahWaterVolume: PhEntity <abstract> {
  water
  volume
}


// Water Volume point
UtahWaterVolumePoint: UtahWaterVolume & NumberPoint <abstract>{
    unit: Unit <quantity:"volume"> "gal"
}

// Water Volume sensor
UtahWaterVolumeSensor: UtahWaterVolumePoint & SensorPoint <abstract>{

}

////////////////////////////////////////////////////
// Water Temp
////////////////////////////////////////////////////

// Water Temp
UtahWaterTemp: PhEntity <abstract> {
  water
  temp
}

// Water Temperature Point
UtahWaterTempPoint: NumberPoint & UtahWaterTemp <abstract>{
    unit: Unit <quantity:"temperature"> "°F"
    }

// Water Temperature Sensor
UtahWaterTempSensor: UtahWaterTempPoint & SensorPoint <abstract>{

    }

// Water Temperature Setpoint
UtahWaterTempSp: UtahWaterTempPoint & SpPoint <abstract>{

    }

// Water Temperatures
// Water Temperature entering a device
UtahWaterTempEntering: UtahWaterTempSensor <abstract>{
    entering
    }

// Water Temperature leaving a device
UtahWaterTempLeaving: UtahWaterTempSensor <abstract>{
    leaving
    }

// Water Temperature leaving a device setpoint
UtahWaterTempLeavingSp: UtahWaterTempSp <abstract>{
    leaving
    }

// Water Temperature Supply
UtahWaterTempSupply: UtahWaterTempSensor <abstract>{
    supply
    }

// Water Temperature Supply
UtahWaterTempSupplySp: UtahWaterTempSp <abstract>{
    supply
    }

// Water Temperature Supply
UtahWaterTempReturn: UtahWaterTempSensor <abstract>{
    return
    }

////////////////////////////////////////////////////
// Water Power
////////////////////////////////////////////////////

// Water Power
UtahWaterPower: PhEntity <abstract> {
  water
  power
}

// Water Power Sensor Point
UtahWaterPowerSensor: UtahWaterPower & SensorPoint <abstract>{
  unit: Unit <quantity:"power"> "kW"
    }

////////////////////////////////////////////////////
// Water Energy
////////////////////////////////////////////////////

// Water Energy
UtahWaterEnergy: PhEntity <abstract> {
  water
  energy
}

// Water Energy Sensor Point
UtahWaterEnergySensor: UtahWaterEnergy & SensorPoint <abstract>{

    }

////////////////////////////////////////////////////
// Shared Chilled Water Points
////////////////////////////////////////////////////

// Concrete chilled water points live here so equipment libs inherit one spec.

// Chilled water isolation valve command
UtahChWIsoVlvCmd: UtahIsoValveCmd & UtahHisCov {
  chilled
  water
  navName: "ChWIsoVlvCmd"
}

// Chilled water circulation pump command
UtahChWCPCmd: UtahCPCmd & UtahHisCov {
  chilled
  water
  navName: "ChWCPCmd"
}

// Chilled water circulation pump command status
UtahChWCPCmdSts: UtahCPCmdSts & UtahHisCov {
  chilled
  water
  navName: "ChWCPCmdSts"
}

// Chilled water flow
UtahChWFlow: UtahWaterFlowSensor & UtahHisSampledMajorEquip {
  chilled
  water
  navName: "ChWFlow"
}

////////////////////////////////////////////////////
// Shared Hot Water Points
////////////////////////////////////////////////////

// Concrete hot water points live here so equipment libs inherit one spec.

// Hot water isolation valve command
UtahHWIsoVlvCmd: UtahIsoValveCmd & UtahHisCov {
  hot
  water
  navName: "HWIsoVlvCmd"
}

// Hot water isolation valve position
UtahHWIsoVlvPos: UtahIsoValvePos & UtahHisSampledMajorEquip {
  hot
  water
  isolation
  navName: "HWIsoVlvPos"
}

// Hot water circulation pump command
UtahHWCPCmd: UtahCPCmd & UtahHisCov {
  hot
  water
  navName: "HWCPCmd"
}

// Hot water circulation pump speed
UtahHWCPSpeed: UtahCPSpd & UtahHisCov {
  hot
  water
  navName: "HWCPSpeed"
}

// Hot water energy
UtahHWEnergy: UtahWaterEnergySensor & UtahHisConsumptionMajorEquip {
  hot
  water
  navName: "HWEnergy"
  unit: Unit <quantity:"energy"> "MMBTU"
}

// Hot water power
UtahHWPower: UtahWaterPowerSensor & UtahHisSampledMajorEquip {
  hot
  water
  navName: "HWPower"
  unit: Unit <quantity:"power"> "MMBTU/h"
}
