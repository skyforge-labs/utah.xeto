// Standalone HVAC pump equip. UtahPump remains the point/component marker.

UtahPumpEquip: UtahEquip & UtahPump {
  hvac

  points: {
    // Enable / run
    pumpEnab:    UtahPumpEnab?
    pumpCmd:     UtahPumpCmd
    pumpCmdSts:  UtahPumpCmdSts?

    // Speed / VFD
    pumpSpd:     UtahPumpSpd?
    pumpSpdSts:  UtahPumpSpdSts?
    pumpFreq:    UtahPumpFreqSensor?

    // Energy
    pumpPower:   UtahPumpPowerPoint?
    pumpEnergy:  UtahPumpEnergyPoint?
  }
}
