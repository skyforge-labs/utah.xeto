// Primary/secondary plant pump hierarchy (ChW + HW share abstracts).

//////////////////////////////////////////////////////////////////////////
// Abstracts
//////////////////////////////////////////////////////////////////////////

UtahPriPumpCmd: UtahPrimary & UtahPumpCmd & UtahHisCov <abstract> { water }
UtahPriPumpCmdSts: UtahPrimary & UtahPumpCmdSts & UtahHisCov <abstract> { water }
UtahPriPumpSpd: UtahPrimary & UtahPumpSpd & UtahHisSampledMajorEquip <abstract> { water }
UtahPriPumpSpdSts: UtahPrimary & UtahPumpSpdSts & UtahHisSampledMajorEquip <abstract> { water }
UtahPriPumpFreq: UtahPrimary & UtahPumpFreqSensor & UtahHisSampledMajorEquip <abstract> { water }
UtahPriPumpPower: UtahPrimary & UtahPumpPowerPoint & UtahHisSampledMajorEquip <abstract> { water }
UtahPriPumpEnergy: UtahPrimary & UtahPumpEnergyPoint & UtahHisConsumptionMajorEquip <abstract> { water }

UtahSecPumpCmd: UtahSecondary & UtahPumpCmd & UtahHisCov <abstract> { water }
UtahSecPumpCmdSts: UtahSecondary & UtahPumpCmdSts & UtahHisCov <abstract> { water }
UtahSecPumpSpd: UtahSecondary & UtahPumpSpd & UtahHisSampledMajorEquip <abstract> { water }
UtahSecPumpSpdSts: UtahSecondary & UtahPumpSpdSts & UtahHisSampledMajorEquip <abstract> { water }
UtahSecPumpFreq: UtahSecondary & UtahPumpFreqSensor & UtahHisSampledMajorEquip <abstract> { water }
UtahSecPumpPower: UtahSecondary & UtahPumpPowerPoint & UtahHisSampledMajorEquip <abstract> { water }
UtahSecPumpEnergy: UtahSecondary & UtahPumpEnergyPoint & UtahHisConsumptionMajorEquip <abstract> { water }

